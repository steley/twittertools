---
const nav = [
  { href: '/twitter-video-downloader', label: 'Video Downloader' },
  { href: '/twitter-thread-reader', label: 'Thread Reader' },
  { href: '/twitter-advanced-search-builder', label: 'Search Builder' },
];
---

<header class="border-b border-slate-200 bg-white/80 backdrop-blur">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2 font-bold tracking-tight">
      <span
        class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand text-white"
        aria-hidden="true"
      >
        <!-- Original TwitterTools "T" mark — intentionally not derived from X/Twitter brand assets -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" class="h-5 w-5" fill="none">
          <rect width="64" height="64" rx="14" fill="#1d9bf0"/>
          <path d="M18 22.5h28M32 22.5V46" stroke="#fff" stroke-width="9" stroke-linecap="round"/>
        </svg>
      </span>
      <span>Twitter<span class="text-brand">Tools</span></span>
    </a>
    <nav class="ml-auto flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-slate-600" aria-label="Main">
      {
        nav.map((item) => (
          <a href={item.href} class="hover:text-brand">
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
