---
import { TOOLS } from '../lib/tools';

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-white">
  <div class="mx-auto grid max-w-5xl gap-8 px-4 py-10 sm:grid-cols-3 sm:px-6">
    <div>
      <p class="font-bold">Twitter<span class="text-brand">Tools</span></p>
      <p class="mt-2 text-sm text-slate-500">
        The independent toolkit for X (Twitter). Free, no sign-up required.
      </p>
      <a
        href="https://github.com/steley/twittertools"
        rel="me"
        class="mt-3 inline-flex items-center gap-2 text-sm text-slate-500 hover:text-brand"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 16 16"
          fill="currentColor"
          class="h-4 w-4"
          aria-hidden="true"
        >
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        Open source on GitHub
      </a>
      <a
        href="mailto:hello@twittertools.com"
        class="mt-2 inline-flex items-center gap-2 text-sm text-slate-500 hover:text-brand"
        aria-label="Email hello@twittertools.com"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4"
          aria-hidden="true"
        >
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
        hello@twittertools.com
      </a>
    </div>
    <nav aria-label="Tools">
      <p class="text-sm font-semibold text-slate-900">Tools</p>
      <ul class="mt-2 space-y-1 text-sm text-slate-500">
        {
          TOOLS.map((t) => (
            <li>
              <a href={t.slug} class="hover:text-brand">
                {t.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label="Site">
      <p class="text-sm font-semibold text-slate-900">Site</p>
      <ul class="mt-2 space-y-1 text-sm text-slate-500">
        <li><a href="/mcp/" class="hover:text-brand">MCP Server</a></li>
        <li><a href="/privacy/" class="hover:text-brand">Privacy Policy</a></li>
        <li><a href="/terms/" class="hover:text-brand">Terms &amp; DMCA</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-slate-100 px-4 py-4 text-center text-xs text-slate-400 sm:px-6">
    © {year} TwitterTools. TwitterTools is an independent project and is not affiliated with,
    endorsed by, or sponsored by X Corp. or Twitter. "X" and "Twitter" are trademarks of their
    respective owners.
  </div>
</footer>
