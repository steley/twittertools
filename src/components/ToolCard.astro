---
import type { Tool } from '../lib/tools';

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
---

<a
  href={tool.slug}
  class="group flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-brand hover:shadow-md"
>
  <span
    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-sky-50 text-brand group-hover:bg-brand group-hover:text-white"
    set:html={tool.icon}
  />
  <span>
    <span class="block font-semibold">{tool.name}</span>
    <span class="mt-1 block text-sm text-slate-500">{tool.tagline}</span>
  </span>
</a>
