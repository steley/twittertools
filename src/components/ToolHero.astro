---
interface Props {
  title: string;
  subtitle: string;
}
const { title, subtitle } = Astro.props;
---

<div class="mb-8">
  <a href="/" class="text-sm text-slate-500 hover:text-brand">← All tools</a>
  <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
  <p class="mt-3 max-w-2xl text-lg text-slate-600">{subtitle}</p>
</div>
