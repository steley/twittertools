---
import Base from '../layouts/Base.astro';
import ToolHero from '../components/ToolHero.astro';
import Faq from '../components/Faq.astro';
import AdSlot from '../components/AdSlot.astro';
import { TOOLS } from '../lib/tools';

const faq = [
  {
    q: 'Where are my bookmarks stored?',
    a: "In your browser's IndexedDB, on this device only. Nothing is uploaded — there is no account, no sync and no server copy. Use the JSON export as a backup or to move your library to another browser.",
  },
  {
    q: 'Can I import my X bookmarks?',
    a: "X doesn't expose bookmarks to any free API, so there is no automatic sync. You can import a bookmarks file from your X data archive (if your archive contains one), paste post URLs in bulk, or bring a TwitterTools JSON export.",
  },
  {
    q: 'What gets saved with a bookmark?',
    a: "A snapshot: the full text, author, the post's images (for videos, their thumbnail linked to the post) and the original link. If the post is later deleted, your snapshot keeps it readable — that is the point of a bookmark manager.",
  },
  {
    q: 'How do I add posts from the other tools?',
    a: 'Every tool (Video Downloader, Image Downloader, Thread Reader, Screenshot Generator) has a Save button on its result. One click stores the post here.',
  },
  {
    q: 'Can I export for Notion or Obsidian?',
    a: 'Yes. The Markdown export writes one section per post — the full text (every post for threads), the images inline, the link, tags and your notes — and pastes cleanly into Notion, Obsidian or any notes app. JSON keeps everything for re-import.',
  },
];

  const seoDescription = "Save X (Twitter) posts to a private bookmark library in your browser — tags, notes, search, JSON and Markdown export. Free, no sign-up, nothing leaves your device.";
const tool = TOOLS.find((t) => t.slug === '/bookmark-manager/')!;
  const related = tool.related.map((s) => TOOLS.find((t) => t.slug === s)!);
  const toolLd = {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: tool.name,
    url: 'https://twittertools.com/bookmark-manager/',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: seoDescription,
  };
---

<Base
  title="X (Twitter) Bookmark Manager — Save Posts Locally, Free"
  description={seoDescription}
  path="/bookmark-manager/"
    jsonLd={[toolLd]}
>
  <Fragment slot="head">
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1d9bf0" />
  </Fragment>
  <ToolHero
    title="X (Twitter) Bookmark Manager"
    subtitle="Collect posts from any tool into a private library stored in your browser. Tag, annotate, export to JSON or Markdown — free, no account, nothing leaves your device."
  />

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <h2 class="font-semibold">Add posts by URL</h2>
    <p class="mt-1 text-sm text-slate-500">One link per line, up to 50 at a time.</p>
    <form id="bm-form" class="mt-3 flex flex-col gap-3">
      <textarea
        id="bm-urls"
        aria-label="Post URLs, one per line"
        rows="3"
        class="w-full rounded-xl border border-slate-300 px-4 py-3 font-mono text-sm focus:border-brand focus:outline-none"
        placeholder="https://x.com/username/status/1234567890123456789"
        spellcheck="false"
      ></textarea>
      <div class="flex items-center gap-3">
        <button
          type="submit"
          id="bm-add"
          class="rounded-xl bg-brand px-8 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark disabled:opacity-50"
        >
          Add
        </button>
        <span id="bm-progress" aria-live="polite" class="text-sm text-slate-500"></span>
      </div>
    </form>
  </section>

  <section class="mt-4 flex flex-wrap items-center gap-2 rounded-2xl border border-slate-200 bg-white p-4">
    <button id="bm-export-json" class="rounded-full border border-slate-300 px-4 py-2 text-xs font-medium text-slate-600 hover:border-brand hover:text-brand">
      Export JSON
    </button>
    <button id="bm-export-md" class="rounded-full border border-slate-300 px-4 py-2 text-xs font-medium text-slate-600 hover:border-brand hover:text-brand">
      Export Markdown
    </button>
    <label class="cursor-pointer rounded-full bg-brand px-4 py-2 text-xs font-semibold text-white hover:bg-brand-dark">
      Import file…
      <input id="bm-file" type="file" accept=".json,.js,.txt" class="hidden" />
    </label>
    <button id="bm-install" class="hidden rounded-full bg-brand px-4 py-2 text-xs font-semibold text-white hover:bg-brand-dark">Install app</button>
    <span id="bm-ios-hint" class="hidden text-xs text-slate-400">Tip: Share → “Add to Home Screen” installs this library as an app with offline access.</span>
    <span class="ml-auto text-xs text-slate-500">Stored locally — export regularly to keep a backup.</span>
  </section>

  <section class="mt-8">
    <div class="flex flex-wrap items-center gap-2">
      <input
        id="bm-search"
        aria-label="Search bookmarks"
        type="search"
        placeholder="Search text, author, tags, notes…"
        class="min-w-56 flex-1 rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:border-brand focus:outline-none"
      />
      <div id="bm-types" class="flex flex-wrap gap-1"></div>
    </div>
    <div id="bm-tags" class="mt-2 flex flex-wrap gap-1"></div>
    <p id="bm-empty" class="mt-6 hidden rounded-xl bg-slate-50 px-4 py-6 text-center text-sm text-slate-500">
      No bookmarks yet — save posts from any tool's result or paste URLs above.
    </p>
    <div id="bm-list" class="mt-4 space-y-3"></div>
    <button id="bm-clear" class="mt-6 hidden text-xs text-slate-400 underline hover:text-red-500">Delete everything</button>
  </section>

  <AdSlot />

  <section class="mt-12">
    <h2 class="text-xl font-bold">A private reading library</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="font-semibold">Snapshots, not just links</p>
        <p class="mt-1 text-sm text-slate-600">
          The full text, images and video thumbnails are stored with every bookmark, so deleted
          posts stay readable in your library.
        </p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="font-semibold">Your device only</p>
        <p class="mt-1 text-sm text-slate-600">
          The library lives in your browser's IndexedDB. No account, no cookies, no server copy —
          the privacy story is the same as every tool here.
        </p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="font-semibold">Yours to export</p>
        <p class="mt-1 text-sm text-slate-600">
          JSON for backups and re-import, Markdown for Notion and Obsidian. No lock-in — it is your
          data.
        </p>
      </div>
    </div>
  </section>

  <Faq items={faq} />

  <section class="mt-12">
    <h2 class="text-xl font-bold">Related tools</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-3">
      {
        related.map((t) => (
          <li>
            <a href={t.slug} class="block rounded-xl border border-slate-200 bg-white p-4 text-sm font-medium hover:border-brand">
              {t.name} <span class="text-slate-400">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  import { cdnDisplayUrl, extractTweetId, fetchTweet, proxiedDownloadUrl, wireMediaImg, type TweetData } from '../lib/api';
  import {
    clearBookmarks,
    deleteBookmark,
    getBookmark,
    importBookmarks,
    listBookmarks,
    putBookmark,
    tweetToBookmark,
    type BookmarkItem,
    type BookmarkMedia,
    type BookmarkType,
  } from '../lib/bookmark-store';

  const form = document.getElementById('bm-form') as HTMLFormElement;
  const urlsBox = document.getElementById('bm-urls') as HTMLTextAreaElement;
  const addBtn = document.getElementById('bm-add') as HTMLButtonElement;
  const progress = document.getElementById('bm-progress')!;
  const searchBox = document.getElementById('bm-search') as HTMLInputElement;
  const typesBox = document.getElementById('bm-types')!;
  const tagsBox = document.getElementById('bm-tags')!;
  const listBox = document.getElementById('bm-list')!;
  const emptyBox = document.getElementById('bm-empty')!;
  const clearBtn = document.getElementById('bm-clear') as HTMLButtonElement;
  const fileInput = document.getElementById('bm-file') as HTMLInputElement;

  const TYPE_LABELS: Record<BookmarkType, string> = {
    video: 'Video',
    photo: 'Photo',
    thread: 'Thread',
    text: 'Text',
    article: 'Article',
  };

  let all: BookmarkItem[] = [];
  let query = '';
  let typeFilter: BookmarkType | 'all' = 'all';
  let tagFilter: string | null = null;

  const el = (tag: string, cls?: string): HTMLElement => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    return n;
  };
  const safeUrl = (item: BookmarkItem) =>
    /^https:\/\/(x|twitter)\.com\//.test(item.url) ? item.url : `https://x.com/i/status/${item.id}`;
  const excerpt = (text: string) => (text.length > 280 ? text.slice(0, 280) + '…' : text);
  // entries saved before inline media existed only carry `thumb`
  const mediaOf = (item: BookmarkItem): BookmarkMedia[] =>
    item.media?.length
      ? item.media
      : item.thumb.startsWith('https://')
        ? [{ type: 'photo', url: item.thumb, width: null, height: null, postUrl: item.url }]
        : [];
  // legacy entries predate inline media or inline video playback. Thread
  // snapshots are NOT upgradable: they carry the whole chain in `posts`, and
  // re-fetching the single pasted post would silently downgrade them to a
  // one-post snapshot with the thread text gone (AUDIT-006).
  const needsUpgrade = (b: BookmarkItem): boolean =>
    b.mediaType !== 'thread' &&
    (!b.media?.length || (b.mediaType === 'video' && !b.media.some((m) => m.videoUrl)));

  // mixed-media posts (video + photos) count toward BOTH categories: they are
  // saved as Video (the primary type) but also match the Photo filter when
  // their media actually contains photos
  const matchesType = (b: BookmarkItem, t: BookmarkType | 'all'): boolean => {
    if (t === 'all') return true;
    if (b.mediaType === t) return true;
    return t === 'photo' && b.mediaType === 'video' && (b.media ?? []).some((m) => m.type === 'photo');
  };

  // --- media viewer ------------------------------------------------------------
  // Click any media image to enlarge it. Images reuse the exact URL the card
  // is already rendering (img.currentSrc — always a cache hit, no
  // re-download); videos play inline from the MP4 variant stored with the
  // bookmark (legacy entries without one fall back to their poster). Posts
  // with several items get prev/next arrows and the arrow keys; click the
  // backdrop or press Esc to close.
  const viewer = el('div', 'fixed inset-0 z-50 hidden items-center justify-center bg-black/85 p-6');
  const viewerStage = el('div', 'relative flex max-h-full max-w-full items-center justify-center');
  // lives on the overlay, not the stage: renderViewer() replaces the stage's
  // children on every switch and would take the counter down with them
  const viewerCounter = el('span', 'absolute top-3 right-3 rounded-full bg-black/60 px-2.5 py-1 text-xs font-medium text-white');
  let viewerList: BookmarkMedia[] = [];
  let viewerImgs: (HTMLImageElement | null)[] = [];
  let viewerIdx = 0;
  let viewerVideo: HTMLVideoElement | null = null;
  let viewerStallTimer = 0; // 6s canplay watchdog for the currently open video
  const stopViewerVideo = () => {
    window.clearTimeout(viewerStallTimer); // a closed viewer must not re-src a detached <video>
    if (viewerVideo) {
      viewerVideo.pause();
      viewerVideo = null;
    }
  };
  const renderViewer = () => {
    const m = viewerList[viewerIdx];
    const cardImg = viewerImgs[viewerIdx] ?? null;
    stopViewerVideo();
    viewerStage.replaceChildren();
    const playsInline = (m.type === 'video' || m.type === 'animated_gif') && !!m.videoUrl;
    if (playsInline) {
      const v = document.createElement('video');
      v.controls = true;
      v.autoplay = true;
      v.setAttribute('playsinline', '');
      v.className = 'max-h-[80vh] max-w-full';
      if (cardImg) v.poster = cardImg.currentSrc || cardImg.src;
      v.src = m.videoUrl!;
      // the video CDN is blocked outright on some networks (no stall like
      // images — a hard error): retry once through the same-origin proxy;
      // play=1 gives inline disposition + Range passthrough, so the
      // timeline scrubs even on the fallback. iOS additionally HANGS on
      // blocked CDNs without firing error — a canplay watchdog catches that.
      const fallbackToProxy = () => {
        if (!v.src.includes('/api/download')) v.src = proxiedDownloadUrl(m.videoUrl!, 'video.mp4', true);
      };
      viewerStallTimer = window.setTimeout(fallbackToProxy, 6000);
      v.addEventListener('canplay', () => window.clearTimeout(viewerStallTimer), { once: true });
      v.addEventListener('error', () => {
        window.clearTimeout(viewerStallTimer);
        if (v.src.includes('/api/download')) {
          // both paths failed — say so instead of leaving a dead player
          const note = el('div', 'flex h-56 max-w-full items-center justify-center rounded-xl bg-slate-100 px-6 text-center text-sm text-slate-500');
          note.textContent = "Couldn't load this video on this connection — try again later, or watch it on X.";
          viewerStage.replaceChildren(note);
          viewerVideo = null;
          return;
        }
        fallbackToProxy();
      });
      v.addEventListener('click', (e) => e.stopPropagation());
      viewerStage.appendChild(v);
      viewerVideo = v;
      // the viewer opens from a tap — an explicit play() in the same task is
      // what iOS accepts; the autoplay attribute alone is ignored there
      v.play().catch(() => {});
    } else {
      const img = document.createElement('img');
      img.alt = '';
      img.className = 'max-h-[80vh] max-w-full object-contain';
      img.src = cardImg ? cardImg.currentSrc || cardImg.src : m.url;
      img.addEventListener('click', (e) => e.stopPropagation());
      viewerStage.appendChild(img);
    }
    const many = viewerList.length > 1;
    prevBtn.classList.toggle('hidden', !many);
    nextBtn.classList.toggle('hidden', !many);
    viewerCounter.classList.toggle('hidden', !many);
    if (many) viewerCounter.textContent = `${viewerIdx + 1}/${viewerList.length}`;
  };
  const moveViewer = (dir: -1 | 1) => {
    viewerIdx = (viewerIdx + dir + viewerList.length) % viewerList.length;
    renderViewer();
  };
  const closeViewer = () => {
    stopViewerVideo();
    viewer.classList.add('hidden');
    viewer.classList.remove('flex');
  };
  const viewerArrow = (dir: -1 | 1, glyph: string) => {
    const b = el(
      'button',
      `absolute top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-xl leading-none text-white hover:bg-black/80 ${dir === -1 ? 'left-3' : 'right-3'}`
    ) as HTMLButtonElement;
    b.type = 'button';
    b.setAttribute('aria-label', dir === -1 ? 'Previous item' : 'Next item');
    b.textContent = glyph;
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      moveViewer(dir);
    });
    return b;
  };
  const prevBtn = viewerArrow(-1, '‹');
  const nextBtn = viewerArrow(1, '›');
  const openViewer = (list: BookmarkMedia[], idx: number, imgs: (HTMLImageElement | null)[]) => {
    if (!imgs[idx]) return; // nothing rendered yet
    viewerList = list;
    viewerImgs = imgs;
    viewerIdx = idx;
    renderViewer();
    viewer.classList.remove('hidden');
    viewer.classList.add('flex');
  };
  viewer.appendChild(prevBtn);
  viewer.appendChild(nextBtn);
  viewer.appendChild(viewerStage);
  viewer.appendChild(viewerCounter);
  viewer.addEventListener('click', closeViewer);
  document.addEventListener('keydown', (e) => {
    if (viewer.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeViewer();
    if (e.key === 'ArrowLeft') moveViewer(-1);
    if (e.key === 'ArrowRight') moveViewer(1);
  });
  document.body.appendChild(viewer);

  // --- filtering ----------------------------------------------------------
  function visible(): BookmarkItem[] {
    const q = query.trim().toLowerCase();
    return all.filter((b) => {
      if (!matchesType(b, typeFilter)) return false;
      if (tagFilter && !b.tags.includes(tagFilter)) return false;
      if (!q) return true;
      return [b.text, b.author, b.handle, b.note, b.tags.join(' ')].join(' ').toLowerCase().includes(q);
    });
  }

  // --- rendering ----------------------------------------------------------
  function renderFilters() {
    const types: (BookmarkType | 'all')[] = ['all', 'video', 'photo', 'article', 'thread', 'text'];
    typesBox.replaceChildren();
    for (const t of types) {
      const count = t === 'all' ? all.length : all.filter((b) => matchesType(b, t)).length;
      const b = el(
        'button',
        'rounded-full px-3 py-1.5 text-xs font-medium ' +
          (typeFilter === t ? 'bg-brand text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200')
      );
      b.textContent = (t === 'all' ? 'All' : TYPE_LABELS[t]) + ` (${count})`;
      b.addEventListener('click', () => {
        typeFilter = t;
        render();
      });
      typesBox.appendChild(b);
    }
    const tags = [...new Set(all.flatMap((b) => b.tags))].sort();
    tagsBox.replaceChildren();
    if (!tags.length) return;
    for (const tag of tags) {
      const chip = el(
        'button',
        'rounded-full px-3 py-1 text-xs ' +
          (tagFilter === tag ? 'bg-slate-800 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200')
      );
      chip.textContent = `#${tag}`;
      chip.addEventListener('click', () => {
        tagFilter = tagFilter === tag ? null : tag;
        render();
      });
      tagsBox.appendChild(chip);
    }
  }

  function render() {
    renderFilters();
    const items = visible();
    emptyBox.classList.toggle('hidden', items.length > 0);
    clearBtn.classList.toggle('hidden', all.length === 0);
    listBox.replaceChildren();
    for (const item of items) listBox.appendChild(renderItem(item));
  }

  function renderItem(item: BookmarkItem): HTMLElement {
    const card = el('article', 'rounded-2xl border border-slate-200 bg-white p-4');

    const main = el('div', 'min-w-0');
    const meta = el('div', 'flex flex-wrap items-center gap-2 text-xs text-slate-500');
    const typeBadge = el('span', 'rounded-full bg-sky-50 px-2 py-0.5 font-semibold text-brand');
    typeBadge.textContent = TYPE_LABELS[item.mediaType];
    meta.appendChild(typeBadge);
    // spans, not bare text nodes: adjacent text nodes merge into one flex
    // item and the gap spacing between them collapses
    if (item.handle) {
      const h = el('span', '');
      h.textContent = '@' + item.handle;
      meta.appendChild(h);
    }
    const d = el('span', '');
    d.textContent = new Date(item.savedAt).toISOString().slice(0, 10);
    meta.appendChild(d);
    main.appendChild(meta);

    // body: threads with a posts array show the first post and expand to all
    // of them; everything else shows the text (long text gets a toggle too)
    const bodyWrap = el('div', 'mt-1.5 text-sm leading-relaxed text-slate-700');
    const posts = item.posts?.length ? item.posts : null;
    let expanded = false;
    const paintBody = () => {
      bodyWrap.replaceChildren();
      if (posts && posts.length > 1) {
        const shown = expanded ? posts : [posts[0]];
        shown.forEach((p, i) => {
          const pe = el('p', 'whitespace-pre-wrap' + (i > 0 ? ' mt-2' : ''));
          pe.textContent = p;
          bodyWrap.appendChild(pe);
        });
      } else {
        const full = posts ? posts[0] ?? '' : item.text;
        const pe = el('p', 'whitespace-pre-wrap');
        pe.textContent = expanded || full.length <= 280 ? full : excerpt(full);
        bodyWrap.appendChild(pe);
      }
      const needsToggle = (posts !== null && posts.length > 1) || (posts === null && item.text.length > 280);
      if (needsToggle) {
        const btn = el('button', 'mt-1.5 block text-xs font-medium text-brand hover:underline') as HTMLButtonElement;
        btn.type = 'button';
        btn.textContent = expanded
          ? 'Show less'
          : posts && posts.length > 1
            ? `Show all ${posts.length} posts`
            : 'Show full post';
        btn.addEventListener('click', () => {
          expanded = !expanded;
          paintBody();
        });
        bodyWrap.appendChild(btn);
      }
    };
    paintBody();
    main.appendChild(bodyWrap);

    // inline media, the same structure for every bookmark type: one item
    // shows whole at its natural aspect (height-capped, left-aligned, never
    // stretched or cropped); multiple items line up horizontally in one row
    // at the same height, and only when the row overflows the card do arrow
    // buttons appear to scroll through it (native swipe works too)
    const mediaList = mediaOf(item);
    if (mediaList.length) {
      const failPlaceholder = (label: string, cls = 'flex h-40 w-full items-center justify-center rounded-xl bg-slate-100 text-xs text-slate-400'): HTMLElement => {
        const d = el('div', cls);
        d.textContent = label;
        return d;
      };
      // one builder for every card image: WebP display variants from the
      // twimg CDN (small/medium/large via srcset — the stored URL keeps
      // pointing at the original, and the proxy fallback fetches the medium
      // variant too), natural-aspect reservation, click-to-enlarge, and a
      // placeholder swap when both CDN and proxy fail.
      const makeImg = (m: BookmarkMedia, cls: string, failCls?: string): HTMLImageElement => {
        const img = document.createElement('img');
        img.alt = m.type === 'video' || m.type === 'animated_gif' ? 'Video thumbnail' : 'Post image';
        img.loading = 'lazy';
        img.decoding = 'async';
        img.className = `${cls} ${m.type === 'video' || m.type === 'animated_gif' ? 'cursor-pointer' : 'cursor-zoom-in'}`;
        if (m.width && m.height) img.style.aspectRatio = `${m.width} / ${m.height}`;
        img.srcset = (['small', 'medium', 'large'] as const)
          .map((n) => `${cdnDisplayUrl(m.url, n)} ${n === 'small' ? '680w' : n === 'medium' ? '1200w' : '2048w'}`)
          .join(', ');
        img.sizes = '(max-width: 768px) 100vw, 700px';
        img.addEventListener('error', () => {
          if (img.src.includes('/api/download')) img.replaceWith(failPlaceholder('Media unavailable', failCls));
        });
        wireMediaImg(img, cdnDisplayUrl(m.url, 'medium'), 'bookmark-image');
        return img;
      };
      const playBadge = (): HTMLElement => {
        const play = el('span', 'pointer-events-none absolute inset-0 flex items-center justify-center');
        play.innerHTML =
          '<span class="flex h-12 w-12 items-center justify-center rounded-full bg-black/60 text-lg text-white">▶</span>';
        return play;
      };
      if (mediaList.length === 1) {
        // whole media visible: natural aspect from the stored dimensions
        // (reserves the box before the bytes arrive), capped at the 384px
        // media height, width follows the ratio — left-aligned
        const m = mediaList[0];
        const isVideo = m.type === 'video' || m.type === 'animated_gif';
        const img = makeImg(m, 'block max-h-96 w-auto max-w-full bg-slate-100' + (isVideo ? '' : ' rounded-xl'));
        img.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          openViewer(mediaList, 0, [img]);
        });
        const wrap = el('div', 'mt-2.5');
        if (isVideo) {
          const link = document.createElement('a');
          link.href = safeUrl(item);
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.className = 'relative inline-block overflow-hidden rounded-xl bg-slate-100';
          link.appendChild(img);
          link.appendChild(playBadge());
          wrap.appendChild(link);
        } else {
          wrap.appendChild(img);
        }
        main.appendChild(wrap);
      } else {
        const wrap = el('div', 'relative mt-2.5');
        const strip = el('div', 'flex h-96 gap-2 overflow-x-auto rounded-xl bg-slate-100 scroll-smooth');
        const arrow = (dir: -1 | 1, label: string, glyph: string, onClick: () => void) => {
          const b = el(
            'button',
            `absolute top-1/2 z-10 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full bg-black/50 text-base leading-none text-white hover:bg-black/70 ${dir === -1 ? 'left-2' : 'right-2'}`
          ) as HTMLButtonElement;
          b.type = 'button';
          b.setAttribute('aria-label', label);
          b.textContent = glyph;
          b.addEventListener('click', onClick);
          return b;
        };
        const prev = arrow(-1, 'Scroll back', '‹', () => strip.scrollBy({ left: -strip.clientWidth * 0.8, behavior: 'smooth' }));
        const next = arrow(1, 'Scroll forward', '›', () => strip.scrollBy({ left: strip.clientWidth * 0.8, behavior: 'smooth' }));
        // arrows only when the row doesn't fit the card
        const updateArrows = () => {
          const overflow = strip.scrollWidth > strip.clientWidth + 4;
          prev.classList.toggle('hidden', !overflow);
          next.classList.toggle('hidden', !overflow);
        };
        strip.addEventListener('scroll', updateArrows, { passive: true });
        const stripFail = 'flex h-96 w-72 shrink-0 items-center justify-center bg-slate-200 text-xs text-slate-400';
        const stripImgs: HTMLImageElement[] = [];
        mediaList.forEach((m, i) => {
          const isVideo = m.type === 'video' || m.type === 'animated_gif';
          const img = makeImg(
            m,
            isVideo
              ? 'block h-full w-auto bg-slate-100'
              : 'block h-96 w-auto shrink-0 rounded-xl bg-slate-100',
            stripFail,
          );
          img.addEventListener('load', updateArrows);
          // poster click plays/enlarges instead of following the post link
          img.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            openViewer(mediaList, i, stripImgs);
          });
          stripImgs.push(img);
          if (isVideo) {
            const link = document.createElement('a');
            link.href = safeUrl(item);
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.className = 'relative block h-full shrink-0 overflow-hidden rounded-xl bg-slate-100';
            link.appendChild(img);
            link.appendChild(playBadge());
            strip.appendChild(link);
          } else {
            strip.appendChild(img);
          }
        });
        wrap.appendChild(strip);
        wrap.appendChild(prev);
        wrap.appendChild(next);
        main.appendChild(wrap);
        // the row may overflow as soon as the reserved boxes land — and legacy
        // entries without stored dimensions only know their width after load
        updateArrows();
      }
    }

    if (item.tags.length) {
      const tagRow = el('div', 'mt-2 flex flex-wrap gap-1');
      for (const tag of item.tags) {
        // click a chip to remove the tag (hover turns it red)
        const chip = el(
          'button',
          'rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500 hover:bg-red-50 hover:text-red-500'
        ) as HTMLButtonElement;
        chip.type = 'button';
        chip.title = 'Remove tag';
        const label = el('span', '');
        label.textContent = '#' + tag;
        const x = el('span', 'ml-0.5 text-slate-400');
        x.textContent = '×';
        chip.appendChild(label);
        chip.appendChild(x);
        chip.addEventListener('click', async () => {
          item.tags = item.tags.filter((t) => t !== tag);
          if (tagFilter === tag) tagFilter = null;
          await putBookmark(item);
          render();
        });
        tagRow.appendChild(chip);
      }
      main.appendChild(tagRow);
    }
    if (item.note) {
      const note = el('p', 'mt-2 rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-800');
      note.textContent = item.note;
      main.appendChild(note);
    }

    const actions = el('div', 'mt-3 flex flex-wrap items-center gap-2');
    const open = el('a', 'rounded-full border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-600 hover:border-brand hover:text-brand');
    (open as HTMLAnchorElement).href = safeUrl(item);
    (open as HTMLAnchorElement).target = '_blank';
    (open as HTMLAnchorElement).rel = 'noopener noreferrer';
    open.textContent = 'Open on X ↗';
    actions.appendChild(open);
    // one-click handoff to the Screenshot Generator (same card, curated)
    const shot = el('button', 'rounded-full border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-600 hover:border-brand hover:text-brand');
    shot.textContent = 'Screenshot';
    shot.addEventListener('click', () => {
      sessionStorage.setItem('twittertools:ss-links', JSON.stringify([safeUrl(item)]));
      window.location.href = '/tweet-screenshot-generator/';
    });
    actions.appendChild(shot);
    const edit = el('button', 'rounded-full border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-600 hover:border-brand hover:text-brand');
    edit.textContent = 'Edit';
    actions.appendChild(edit);
    const del = el('button', 'rounded-full border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-600 hover:border-red-400 hover:text-red-500');
    del.textContent = 'Delete';
    del.addEventListener('click', async () => {
      await deleteBookmark(item.id);
      all = all.filter((b) => b.id !== item.id);
      render();
    });
    actions.appendChild(del);
    main.appendChild(actions);

    const panel = el('div', 'mt-3 hidden space-y-2');
    const tagInput = el('input', 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none') as HTMLInputElement;
    tagInput.placeholder = 'Add a tag and press Enter — click a #tag to remove it';
    tagInput.value = '';
    tagInput.addEventListener('keydown', async (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      const tag = tagInput.value.trim().replace(/^#/, '');
      if (!tag || item.tags.includes(tag)) return;
      item.tags.push(tag);
      await putBookmark(item);
      render();
    });
    panel.appendChild(tagInput);
    const noteArea = el('textarea', 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none') as HTMLTextAreaElement;
    noteArea.rows = 2;
    noteArea.placeholder = 'Your note…';
    noteArea.value = item.note;
    let noteTimer: ReturnType<typeof setTimeout> | undefined;
    noteArea.addEventListener('input', () => {
      clearTimeout(noteTimer);
    noteTimer = setTimeout(() => {
      item.note = noteArea.value;
      // a pending save must not resurrect a bookmark deleted in the meantime
      if (all.some((b) => b.id === item.id)) putBookmark(item);
    }, 600);
    });
    panel.appendChild(noteArea);
    edit.addEventListener('click', () => panel.classList.toggle('hidden'));
    main.appendChild(panel);

    card.appendChild(main);
    return card;
  }

  // --- add by URL -----------------------------------------------------------
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const ids: string[] = [];
    for (const line of urlsBox.value.split('\n')) {
      const id = extractTweetId(line);
      if (id && !ids.includes(id)) ids.push(id);
    }
    if (!ids.length) {
      progress.textContent = "No valid post links found — paste x.com/…/status/… links, one per line.";
      return;
    }
    const batch = ids.slice(0, 50);
    addBtn.disabled = true;
    let added = 0;
    let dup = 0;
    let failed = 0;
    let upgraded = 0;
    try {
      for (let i = 0; i < batch.length; i++) {
        progress.textContent = `Fetching ${i + 1}/${batch.length}…`;
        try {
          const existing = await getBookmark(batch[i]);
          if (existing && !needsUpgrade(existing)) {
            dup++;
          } else {
            const t = await fetchTweet(batch[i]);
            const fresh = tweetToBookmark(t);
            if (existing) {
              // refresh a legacy entry in place (inline media / video playback),
              // keeping the user's tags and note
              fresh.tags = existing.tags;
              fresh.note = existing.note;
              upgraded++;
            } else {
              added++;
            }
            await putBookmark(fresh);
          }
        } catch {
          failed++;
        }
        await new Promise((r) => setTimeout(r, 1100)); // stay well under the API rate limit
      }
    } finally {
      // the button must recover even if listBookmarks/render throws
      addBtn.disabled = false;
    }
    urlsBox.value = '';
    progress.textContent = `Added ${added}${upgraded ? `, ${upgraded} refreshed` : ''}${dup ? `, ${dup} already saved` : ''}${failed ? `, ${failed} failed` : ''}.`;
    all = await listBookmarks();
    render();
  });

  // --- exports --------------------------------------------------------------
  function download(filename: string, content: string, type: string) {
    const blob = new Blob([content], { type });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 5000);
  }

  // --- PWA: scoped service worker + install prompt ---------------------------
  // The worker's scope is /bookmark-manager/ only — no other page is controlled.
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/bookmark-manager/sw.js').catch(() => {});
  }
  const installBtn = document.getElementById('bm-install') as HTMLButtonElement;
  const iosHint = document.getElementById('bm-ios-hint')!;
  let deferredPrompt: { prompt: () => void; userChoice: Promise<unknown> } | null = null;
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e as unknown as typeof deferredPrompt;
    installBtn.classList.remove('hidden');
  });
  installBtn.addEventListener('click', async () => {
    if (!deferredPrompt) return;
    deferredPrompt.prompt();
    await deferredPrompt.userChoice.catch(() => undefined);
    deferredPrompt = null;
    installBtn.classList.add('hidden');
  });
  window.addEventListener('appinstalled', () => installBtn.classList.add('hidden'));
  const standalone =
    window.matchMedia('(display-mode: standalone)').matches || ('standalone' in window.navigator && window.navigator.standalone);
  // storage can throw entirely (cookies disabled, sandboxed context) — guard
  // both reads and writes so the rest of the script below still gets wired up
  let iosHintSeen = false;
  try {
    iosHintSeen = !!localStorage.getItem('bm-ios-hint-seen');
  } catch {
    /* storage unavailable — just show the hint */
  }
  if (/iphone|ipad|ipod/i.test(navigator.userAgent) && !standalone && !iosHintSeen) {
    iosHint.classList.remove('hidden');
    try {
      localStorage.setItem('bm-ios-hint-seen', '1');
    } catch {
      /* private mode */
    }
  }

  document.getElementById('bm-export-json')!.addEventListener('click', () => {
    const payload = { version: 1, exportedAt: new Date().toISOString(), bookmarks: all };
    download(
      `twittertools-bookmarks-${new Date().toISOString().slice(0, 10)}.json`,
      JSON.stringify(payload, null, 2),
      'application/json'
    );
  });

  document.getElementById('bm-export-md')!.addEventListener('click', () => {
    const parts = all.map((b, i) => {
      const head = `### ${i + 1}. ${b.author || '@' + b.handle} · ${TYPE_LABELS[b.mediaType]} · ${new Date(b.savedAt).toISOString().slice(0, 10)}`;
      // photos embed inline; videos/GIFs carry their thumbnail linked to the post
      const media = mediaOf(b)
        .map((m) =>
          m.type === 'video' || m.type === 'animated_gif'
            ? `[![video](${m.url})](${safeUrl(b)})`
            : `![image](${m.url})`
        )
        .join('\n\n');
      const tags = b.tags.length ? `\n\nTags: ${b.tags.map((t) => '#' + t).join(', ')}` : '';
      const note = b.note ? `\n\n> ${b.note.replace(/\n/g, '\n> ')}` : '';
      // threads export every post; photos embed inline; videos carry their
      // thumbnail linked to the post
      const body = b.posts && b.posts.length > 1 ? b.posts.join('\n\n') : b.text;
      return `${head}\n\n${body}${media ? '\n\n' + media : ''}\n\n${safeUrl(b)}${tags}${note}`;
    });
    const md =
      `# My X Bookmarks\n\n> Exported from twittertools.com — ${new Date().toISOString().slice(0, 10)}\n\n` +
      parts.join('\n\n---\n\n') +
      '\n';
    download(`twittertools-bookmarks-${new Date().toISOString().slice(0, 10)}.md`, md, 'text/markdown');
  });

  // --- import ----------------------------------------------------------------
  async function fetchMetaForIds(ids: string[]): Promise<BookmarkItem[]> {
    const out: BookmarkItem[] = [];
    for (let i = 0; i < ids.length; i++) {
      progress.textContent = `Fetching metadata ${i + 1}/${ids.length}…`;
      try {
        const t: TweetData = await fetchTweet(ids[i]);
        out.push(tweetToBookmark(t));
      } catch {
        /* deleted / protected — skip */
      }
      await new Promise((r) => setTimeout(r, 1100));
    }
    return out;
  }

  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    const text = await file.text();
    progress.textContent = 'Parsing…';
    try {
      if (/window\.YTD/.test(text)) {
        // X data archive format: entries carry only tweetIds — resolve via the API.
        // Other collections (likes.js etc.) also carry "tweetId" — only accept
        // the bookmarks one, or a likes import would silently become bookmarks.
        const collection = /window\.YTD\.([A-Za-z]+)/.exec(text)?.[1];
        if (collection && collection !== 'bookmark') {
          progress.textContent = `That file is the "${collection}" collection — import the bookmarks.js file instead.`;
          return;
        }
        const ids = [...text.matchAll(/"tweetId"\s*:\s*"(\d+)"/g)].map((m) => m[1]);
        const unique = [...new Set(ids)].slice(0, 50);
        if (!unique.length) {
          progress.textContent = 'No bookmark entries found in that archive file.';
          return;
        }
        const items = await fetchMetaForIds(unique);
        const added = await importBookmarks(items);
        progress.textContent = `Imported ${added} from the archive${ids.length > 50 ? ' (first 50 — repeat with the remaining ones)' : ''}.`;
      } else {
        const parsed = JSON.parse(text);
        const items = Array.isArray(parsed) ? parsed : Array.isArray(parsed?.bookmarks) ? parsed.bookmarks : null;
        if (!items) {
          progress.textContent = 'Unrecognised file — expected a TwitterTools JSON export.';
          return;
        }
        const added = await importBookmarks(items);
        progress.textContent = `Imported ${added}${items.length > added ? ` (${items.length - added} duplicates skipped)` : ''}.`;
      }
      all = await listBookmarks();
      render();
    } catch {
      progress.textContent = 'Could not read that file.';
    } finally {
      fileInput.value = '';
    }
  });

  clearBtn.addEventListener('click', async () => {
    if (!confirm('Delete every bookmark on this device? Export first if you want a backup.')) return;
    await clearBookmarks();
    all = [];
    tagFilter = null;
    render();
  });

  searchBox.addEventListener('input', () => {
    query = searchBox.value;
    render();
  });

  all = await listBookmarks();
  render();
</script>
