---
import Base from '../layouts/Base.astro';
import ToolHero from '../components/ToolHero.astro';
import Faq from '../components/Faq.astro';
import AdSlot from '../components/AdSlot.astro';
import { TOOLS } from '../lib/tools';

const faq = [
  {
    q: 'How do I save photos from an X (Twitter) post in full resolution?',
    a: 'Paste the post link above and press Fetch. Every photo in the post is listed with a download button that grabs the original "name=orig" version — the highest resolution X stores, not the compressed preview.',
  },
  {
    q: 'Can I download all images from a post at once?',
    a: 'Yes. Posts can hold up to 4 photos; the "Download all" button saves every original one after another.',
  },
  {
    q: 'Why is the downloaded image bigger than on X?',
    a: 'The X app and website show compressed previews for speed. The original file you get here is the version that was uploaded, often several times larger.',
  },
  {
    q: 'Does it work for videos too?',
    a: 'This page is for photos. For videos and GIFs use the Video Downloader — same input, different output.',
  },
];

const related = TOOLS.filter((t) => t.slug !== '/twitter-image-downloader').slice(0, 3);

  const tool = TOOLS.find((t) => t.slug === '/twitter-image-downloader')!;
  const toolLd = {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: tool.name,
    url: 'https://twittertools.com/twitter-image-downloader/',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: tool.tagline,
  };
---

<Base
  title="X (Twitter) Image Downloader — Save Photos in Original Quality"
  description="Download photos from X (Twitter) posts in full original resolution. Paste a post link, save single images or all of them at once. Free, no sign-up, works on mobile."
  path="/twitter-image-downloader"
    jsonLd={[toolLd]}
>
  <ToolHero
    title="X (Twitter) Image Downloader"
    subtitle="Paste a link to any public post — save every photo in its original uploaded quality, one by one or all at once."
  />

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <form id="id-form" class="flex flex-col gap-3 sm:flex-row">
      <input
        id="id-url"
        aria-label="Post URL"
        type="text"
        inputmode="url"
        class="w-full flex-1 rounded-xl border border-slate-300 px-4 py-3 font-mono text-sm focus:border-brand focus:outline-none"
        placeholder="https://x.com/username/status/1234567890123456789"
        autocomplete="off"
        spellcheck="false"
        required
      />
      <button
        type="submit"
        id="id-btn"
        class="rounded-xl bg-brand px-8 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark disabled:opacity-50"
      >
        Fetch
      </button>
    </form>
    <p class="mt-2 text-xs text-slate-500">
      Works with x.com and twitter.com links. Only public posts can be processed.
    </p>

    <div id="id-error" class="mt-4 hidden rounded-xl bg-red-50 px-4 py-3 text-sm text-red-600"></div>
    <div id="id-result" class="mt-5"></div>
  </section>

  <AdSlot />

  <section class="mt-12">
    <h2 class="text-xl font-bold">How it works</h2>
    <ol class="mt-4 grid gap-4 sm:grid-cols-3">
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-bold text-brand">Step 1</p>
        <p class="mt-1 font-medium">Copy the post link</p>
        <p class="mt-1 text-sm text-slate-600">
          Share → "Copy link" on the post containing the photo(s).
        </p>
      </li>
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-bold text-brand">Step 2</p>
        <p class="mt-1 font-medium">Fetch the post</p>
        <p class="mt-1 text-sm text-slate-600">
          All images appear as full-size previews — one, two or all four from a single post.
        </p>
      </li>
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-bold text-brand">Step 3</p>
        <p class="mt-1 font-medium">Save in original quality</p>
        <p class="mt-1 text-sm text-slate-600">
          Each download pulls the original <code class="text-xs">name=orig</code> file straight
          from X's image CDN.
        </p>
      </li>
    </ol>
  </section>

  <Faq items={faq} />

  <section class="mt-12">
    <h2 class="text-xl font-bold">Related tools</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-3">
      {
        related.map((t) => (
          <li>
            <a href={t.slug} class="block rounded-xl border border-slate-200 bg-white p-4 text-sm font-medium hover:border-brand">
              {t.name} <span class="text-slate-400">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  import { proxiedDownloadUrl, wireMediaImg, type MediaItem, type TweetData } from '../lib/api';
  import { bookmarkToggleButton, tweetToBookmark } from '../lib/bookmark-store';
  import { el, renderTweetHeader, wireFetcher } from '../lib/media-page';

  const form = document.getElementById('id-form') as HTMLFormElement;
  const urlInput = document.getElementById('id-url') as HTMLInputElement;
  const btn = document.getElementById('id-btn') as HTMLButtonElement;
  const errorBox = document.getElementById('id-error')!;
  const result = document.getElementById('id-result')!;

  /** Upgrade a pbs.twimg.com/media/... URL to the original-resolution variant. */
  function origUrl(url: string): string {
    const m = url.match(/^(https:\/\/pbs\.twimg\.com\/media\/[A-Za-z0-9_-]+?)(?:\.([a-z0-9]+))?(?:\?.*)?$/i);
    if (m) {
      const ext = m[2] || 'jpg';
      return `${m[1]}?format=${ext}&name=orig`;
    }
    return url + ':orig';
  }

  function renderTweet(t: TweetData) {
    result.replaceChildren();

    const box = el('div', 'rounded-xl border border-slate-200 p-4');
    box.appendChild(renderTweetHeader(t));
    if (t.text) {
      const text = el('p', 'mt-3 whitespace-pre-wrap text-sm leading-relaxed text-slate-700');
      text.textContent = t.text;
      box.appendChild(text);
    }
    const actions = el('div', 'mt-3');
    actions.appendChild(bookmarkToggleButton(tweetToBookmark(t)));
    box.appendChild(actions);
    result.appendChild(box);

    const photos = t.media.filter((m) => m.type === 'photo');
    const videos = t.media.filter((m) => m.type !== 'photo');

    if (photos.length) {
      const actions = el('div', 'mt-4 flex items-center justify-between');
      const count = el('p', 'text-sm font-medium text-slate-600');
      count.textContent = `${photos.length} photo${photos.length > 1 ? 's' : ''} found (original quality)`;
      actions.appendChild(count);
      if (photos.length > 1) {
        const all = el(
          'button',
          'rounded-full border border-brand px-4 py-2 text-xs font-semibold text-brand hover:bg-brand hover:text-white'
        );
        all.textContent = 'Download all';
        all.addEventListener('click', () => downloadAll(photos));
        actions.appendChild(all);
      }
      result.appendChild(actions);

      const grid = el('div', 'mt-4 grid gap-4 sm:grid-cols-2');
      for (const p of photos) {
        const card = el('div', 'overflow-hidden rounded-xl border border-slate-200');
        const img = document.createElement('img');
        img.alt = 'Post image';
        img.loading = 'lazy';
        img.className = 'max-h-72 w-full bg-slate-100 object-contain';
        wireMediaImg(img, p.url + (p.url.includes('?') ? '&' : '?') + 'name=small', 'image-preview');
        card.appendChild(img);

        const bar = el('div', 'flex items-center gap-2 px-3 py-2.5');
        const dims = el('p', 'flex-1 text-xs text-slate-500');
        dims.textContent = p.width && p.height ? `${p.width}×${p.height}px source` : 'image';
        bar.appendChild(dims);
        const open = document.createElement('a');
        open.href = origUrl(p.url);
        open.target = '_blank';
        open.rel = 'noopener noreferrer';
        open.className = 'rounded-full border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-600 hover:border-brand hover:text-brand';
        open.textContent = 'Open';
        bar.appendChild(open);
        const dl = document.createElement('a');
        const base = origUrl(p.url).split('?')[0].split('/').pop() ?? 'photo.jpg';
        const ext = base.match(/\.(jpg|jpeg|png|webp|gif)$/i)?.[1] ?? 'jpg';
        const name = base.replace(/\.(jpg|jpeg|png|webp|gif)$/i, '') + '-orig.' + ext;
        dl.href = proxiedDownloadUrl(origUrl(p.url), name);
        dl.download = '';
        dl.className = 'rounded-full bg-brand px-4 py-1.5 text-xs font-semibold text-white hover:bg-brand-dark';
        dl.textContent = 'Download';
        bar.appendChild(dl);
        card.appendChild(bar);
        grid.appendChild(card);
      }
      result.appendChild(grid);
    } else if (videos.length) {
      const note = el('p', 'mt-4 rounded-xl bg-sky-50 px-4 py-3 text-sm text-sky-700');
      note.innerHTML =
        'This post contains video/GIF but no photo. Use the <a class="font-semibold underline" href="/twitter-video-downloader">Video Downloader</a> for those.';
      result.appendChild(note);
    } else {
      const note = el('p', 'mt-4 rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-700');
      note.textContent = 'This post has no photos attached.';
      result.appendChild(note);
    }
  }

  async function downloadAll(photos: MediaItem[]) {
    for (const p of photos) {
      const base = origUrl(p.url).split('?')[0].split('/').pop() ?? 'photo.jpg';
      const ext = base.match(/\.(jpg|jpeg|png|webp|gif)$/i)?.[1] ?? 'jpg';
      const a = document.createElement('a');
      a.href = proxiedDownloadUrl(origUrl(p.url), base.replace(/\.(jpg|jpeg|png|webp|gif)$/i, '') + '-orig.' + ext);
      a.download = '';
      document.body.appendChild(a);
      a.click();
      a.remove();
      await new Promise((r) => setTimeout(r, 800));
    }
  }

  wireFetcher({ form, input: urlInput, button: btn, errorBox, busyLabel: 'Fetching…', render: renderTweet });
</script>
