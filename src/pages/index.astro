---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import { CATEGORY_LABELS, toolsByCategory, type ToolCategory } from '../lib/tools';

const order: ToolCategory[] = ['download', 'read', 'write', 'create', 'dev'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'TwitterTools — Free Tools for X (Twitter)',
  description:
    'Free browser-based tools for X (Twitter): download videos and images, unroll threads, count characters and build advanced searches. No sign-up required.',
  url: 'https://twittertools.com',
};
---

<Base
  title="TwitterTools — Free Tools for X (Twitter)"
  description="Free tools for X (Twitter): video & image downloader, thread reader, character counter and an advanced search builder. 100% free, no sign-up, works in your browser."
  path="/"
  jsonLd={[jsonLd]}
>
  <section class="py-8 text-center sm:py-14">
    <p
      class="mx-auto mb-4 inline-block rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-xs font-medium text-brand"
    >
      Free · No sign-up · Works in your browser
    </p>
    <h1 class="mx-auto max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">
      Twitter<span class="text-brand">Tools</span> — the independent toolkit for
      <span class="whitespace-nowrap">X (Twitter)</span>
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">
      Download videos, unroll threads, count characters and search X like a pro. No account, no
      tracking, no paywall.
    </p>

    <form id="home-form" class="mx-auto mt-8 flex max-w-2xl flex-col gap-3 sm:flex-row">
      <input
        id="home-url"
        type="text"
        inputmode="url"
        class="w-full flex-1 rounded-xl border border-slate-300 px-4 py-3 font-mono text-sm focus:border-brand focus:outline-none"
        placeholder="https://x.com/username/status/1234567890123456789"
        autocomplete="off"
        spellcheck="false"
      />
      <button
        type="submit"
        id="home-btn"
        class="rounded-xl bg-brand px-8 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark disabled:opacity-50"
      >
        Go
      </button>
    </form>
    <p class="mt-2 text-xs text-slate-400">
      Paste any public post link — we detect video, photos or text and open the right tool.
    </p>
    <div
      id="home-error"
      class="mx-auto mt-4 hidden max-w-2xl rounded-xl bg-red-50 px-4 py-3 text-left text-sm text-red-600"
    ></div>
    <div
      id="home-choose"
      class="mx-auto mt-4 hidden max-w-2xl rounded-xl bg-sky-50 px-4 py-3 text-left text-sm text-sky-700"
    ></div>
  </section>

  {
    order.map((category) => {
      const tools = toolsByCategory(category);
      const meta = CATEGORY_LABELS[category];
      return (
        <section class="mt-10">
          <div class="mb-4 flex items-baseline justify-between gap-4">
            <h2 class="text-xl font-bold">{meta.title}</h2>
            <p class="hidden text-sm text-slate-500 sm:block">{meta.blurb}</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {tools.map((tool) => (
              <ToolCard tool={tool} />
            ))}
          </div>
        </section>
      );
    })
  }

  <section class="mt-16 grid gap-4 rounded-2xl border border-slate-200 bg-white p-6 sm:grid-cols-3 sm:p-8">
    <div>
      <h3 class="font-semibold">100% free</h3>
      <p class="mt-1 text-sm text-slate-600">
        No accounts, no premium tiers on the core tools. Everything on this site works without
        signing in.
      </p>
    </div>
    <div>
      <h3 class="font-semibold">Privacy-first</h3>
      <p class="mt-1 text-sm text-slate-600">
        Counting, parsing and searching happen entirely in your browser. We never see your text
        unless you ask us to fetch a public post.
      </p>
    </div>
    <div>
      <h3 class="font-semibold">Built for X power users</h3>
      <p class="mt-1 text-sm text-slate-600">
        Independent and unaffiliated with X Corp. — just utilities that respect your time.
      </p>
    </div>
  </section>
</Base>

<script>
  import { extractTweetId, fetchTweet } from '../lib/api';

  const form = document.getElementById('home-form') as HTMLFormElement;
  const input = document.getElementById('home-url') as HTMLInputElement;
  const btn = document.getElementById('home-btn') as HTMLButtonElement;
  const errorBox = document.getElementById('home-error')!;
  const chooseBox = document.getElementById('home-choose')!;

  const esc = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const toolUrl = (slug: string, postUrl: string) => `${slug}?url=${encodeURIComponent(postUrl)}`;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');
    chooseBox.classList.add('hidden');
    const id = extractTweetId(input.value);
    if (!id) {
      errorBox.innerHTML =
        "That doesn't look like a post link. Paste something like <span class='font-mono'>https://x.com/user/status/123…</span>";
      errorBox.classList.remove('hidden');
      return;
    }
    const idle = btn.textContent ?? 'Go';
    btn.disabled = true;
    btn.textContent = 'Checking…';
    try {
      const t = await fetchTweet(id);
      const postUrl = t.url || `https://x.com/i/status/${id}`;
      const videos = t.media.filter((m) => m.type === 'video' || m.type === 'animated_gif');
      const photos = t.media.filter((m) => m.type === 'photo');
      if (videos.length && photos.length) {
        chooseBox.innerHTML =
          `This post has ${videos.length} video and ${photos.length} photo${photos.length > 1 ? 's' : ''} — open the ` +
          `<a class="font-semibold underline" href="${toolUrl('/twitter-video-downloader', postUrl)}">Video Downloader</a> or the ` +
          `<a class="font-semibold underline" href="${toolUrl('/twitter-image-downloader', postUrl)}">Image Downloader</a>.`;
        chooseBox.classList.remove('hidden');
      } else if (videos.length) {
        location.assign(toolUrl('/twitter-video-downloader', postUrl));
      } else if (photos.length) {
        location.assign(toolUrl('/twitter-image-downloader', postUrl));
      } else {
        location.assign(toolUrl('/twitter-thread-reader', postUrl));
      }
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Something went wrong. Please try again.';
      errorBox.innerHTML =
        `${esc(msg)} You can also go straight to the ` +
        `<a class="font-semibold underline" href="/twitter-video-downloader">Video Downloader</a>, ` +
        `<a class="font-semibold underline" href="/twitter-image-downloader">Image Downloader</a> or ` +
        `<a class="font-semibold underline" href="/twitter-thread-reader">Thread Reader</a>.`;
      errorBox.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = idle;
    }
  });
</script>
