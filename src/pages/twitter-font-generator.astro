---
import Base from '../layouts/Base.astro';
import ToolHero from '../components/ToolHero.astro';
import Faq from '../components/Faq.astro';
import AdSlot from '../components/AdSlot.astro';
import { TOOLS } from '../lib/tools';

const faq = [
  {
    q: 'Where can I use these fonts?',
    a: 'Anywhere that accepts plain text: posts, replies, your display name and bio on X — and basically every other app. The letters are real Unicode characters, not images, so they copy and paste like normal text.',
  },
  {
    q: 'Why does my text look different on some devices?',
    a: 'The styles are Unicode math symbols, and a few of them (Script, Fraktur, Double-struck) are missing rare glyphs on older system fonts — those letters fall back to a plainer look. Bold, Italic and the Sans styles render reliably everywhere.',
  },
  {
    q: 'Are styled posts bad for accessibility?',
    a: 'They can be. Screen readers announce each styled letter individually (B-O-L-D instead of "bold"), so use them for short emphasis — a word or a phrase — not for whole sentences. For accessibility-first posts, plain text with capitalization works better.',
  },
  {
    q: 'Do styled characters count differently against the limit?',
    a: 'Yes — styled letters are non-Latin code points, and X weighs them like CJK: 2 characters each. Our Character Counter applies the same rule if you want to check a styled post.',
  },
  {
    q: 'Is my text uploaded anywhere?',
    a: 'No. The conversion runs entirely in your browser — nothing is sent to any server and nothing is stored.',
  },
];

const related = TOOLS.filter((t) => t.slug !== '/twitter-font-generator').slice(0, 3);
---

<Base
  title="Twitter Font Generator — Bold, Italic & Styled Text for X | Free"
  description="Turn text into bold, italic, script, Fraktur and other Unicode styles for X (Twitter) posts and bios. Copy with one click, free, runs in your browser."
  path="/twitter-font-generator"
>
  <ToolHero
    title="Twitter Font Generator"
    subtitle="Type once — get bold, italic, 𝓼𝓬𝓻𝓲𝓹𝓽, 𝕕𝕠𝕦𝕓𝕝𝕖-𝕤𝕥𝕣𝕦𝕔𝕜 and more, ready to paste into any post or bio. Free, no sign-up, rendered in your browser."
  />

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <label for="ff-input" class="mb-2 block text-sm font-medium text-slate-700">
      Your text — letters and digits get restyled, everything else passes through
    </label>
    <textarea
      id="ff-input"
      aria-label="Text to style"
      rows="3"
      class="w-full resize-y rounded-xl border border-slate-300 p-4 text-base leading-relaxed focus:border-brand focus:outline-none"
      placeholder="Type the text you want to style…"
    ></textarea>
    <div id="ff-result" class="mt-5 space-y-3"></div>
    <p id="ff-empty" class="mt-5 text-sm text-slate-400">Start typing above and every style appears here with a one-click Copy.</p>
  </section>

  <AdSlot />

  <section class="mt-12">
    <h2 class="text-xl font-bold">How to use styled fonts on X</h2>
    <ol class="mt-4 grid gap-4 sm:grid-cols-3">
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-bold text-brand">Step 1</p>
        <p class="mt-1 font-medium">Type your text</p>
        <p class="mt-1 text-sm text-slate-600">
          Type it once — all styles update live, letter by letter, with nothing leaving your browser.
        </p>
      </li>
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-bold text-brand">Step 2</p>
        <p class="mt-1 font-medium">Pick a style and copy</p>
        <p class="mt-1 text-sm text-slate-600">
          Bold for emphasis, Script for elegance, Monospace for code. One click copies the styled text.
        </p>
      </li>
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-bold text-brand">Step 3</p>
        <p class="mt-1 font-medium">Paste anywhere</p>
        <p class="mt-1 text-sm text-slate-600">
          Posts, replies, bios, display names — the styled letters are real Unicode text and paste
          like normal characters.
        </p>
      </li>
    </ol>
  </section>

  <Faq items={faq} />

  <section class="mt-12">
    <h2 class="text-xl font-bold">Related tools</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-3">
      {
        related.map((t) => (
          <li>
            <a href={t.slug} class="block rounded-xl border border-slate-200 bg-white p-4 text-sm font-medium hover:border-brand">
              {t.name} <span class="text-slate-400">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  import { convertWithStyle, fontStyleNames } from '../lib/tweet-fonts';
  import { countTweet } from '../lib/tweet-count';
  import { el } from '../lib/media-page';

  const input = document.getElementById('ff-input') as HTMLTextAreaElement;
  const resultBox = document.getElementById('ff-result')!;
  const emptyHint = document.getElementById('ff-empty')!;

  interface Row {
    row: HTMLElement;
    text: string;
  }
  const rows: Row[] = [];

  for (let i = 0; i < fontStyleNames.length; i++) {
    const row = el('div', 'rounded-xl border border-slate-200 p-4');
    const head = el('div', 'flex items-center justify-between gap-3');
    const name = el('span', 'text-xs font-semibold uppercase tracking-wide text-slate-400');
    name.textContent = fontStyleNames[i];
    head.appendChild(name);
    const copy = el(
      'button',
      'ff-copy rounded-full border border-slate-300 px-4 py-1.5 text-xs font-medium text-slate-600 hover:border-brand hover:text-brand'
    ) as HTMLButtonElement;
    copy.type = 'button';
    copy.textContent = 'Copy';
    head.appendChild(copy);
    const body = el('p', 'ff-text mt-2 break-words text-lg leading-relaxed text-slate-800');
    row.append(head, body);
    resultBox.appendChild(row);
    rows.push({ row, text: '' });

    copy.addEventListener('click', async () => {
      if (!rows[i].text) return;
      await navigator.clipboard.writeText(rows[i].text);
      copy.textContent = '✓ Copied';
      setTimeout(() => (copy.textContent = 'Copy'), 1200);
    });
  }

  let debounce: ReturnType<typeof setTimeout>;
  input.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(render, 150);
  });

  function render() {
    const value = input.value;
    emptyHint.classList.toggle('hidden', !!value.trim());
    rows.forEach((r, i) => {
      r.text = value ? convertWithStyle(value, i) : '';
      const body = r.row.querySelector('p')!;
      body.textContent = r.text;
      // dim rows whose text would blow up the post limit (styled chars weigh 2)
      const over = !!value && countTweet(r.text).weightedLength > 280;
      r.row.classList.toggle('opacity-40', over);
      r.row.title = over ? 'Over the 280-character weighted limit for a single post' : '';
    });
  }
  render();
</script>
