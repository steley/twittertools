---
import Base from '../layouts/Base.astro';
import ToolHero from '../components/ToolHero.astro';
import Faq from '../components/Faq.astro';
import AdSlot from '../components/AdSlot.astro';
import { TOOLS } from '../lib/tools';

const faq = [
  {
    q: 'How does the thread reader work?',
    a: 'Paste a link to any post in a thread and TwitterTools follows the reply chain backwards to collect every post, then shows the whole thread on one clean page — which is why the last post of a thread gives the best results. When the free embed endpoint can\'t provide the chain, switch to Paste mode and drop the text in yourself — all reading and export features still work.',
  },
  {
    q: 'Can I export a thread as Markdown?',
    a: 'Yes — one click gives you a .md file with every post numbered, photos embedded as images and videos linked, ready for Notion, Obsidian, GitHub or any static-site generator. TXT and standalone HTML exports are there too, and the PDF export opens your browser\'s print dialog — choose "Save as PDF".',
  },
  {
    q: 'Do I need to log in to X?',
    a: 'Never. The reader only fetches public posts through X\'s embed endpoint. No OAuth, no cookies, no account access of any kind.',
  },
  {
    q: 'Why can\'t some threads be unrolled?',
    a: 'Deleted posts, protected accounts and occasional restrictions on X\'s embed endpoint can break the chain. The tool tells you when a thread is only partially available and offers the paste mode as a reliable fallback.',
  },
  {
    q: 'Is this like Thread Reader App?',
    a: 'It\'s the same idea — unroll, read, export — but independent, free, and combined with the rest of the TwitterTools toolkit. No account required and no storage of what you unroll.',
  },
];

const related = TOOLS.filter((t) => t.slug !== '/twitter-thread-reader').slice(0, 3);
---

<Base
  title="X (Twitter) Thread Reader — Unroll & Export to Markdown | Free"
  description="Unroll any public X (Twitter) thread into one readable page. Copy the whole thread or export it as Markdown, TXT, HTML or PDF. Free, no login required."
  path="/twitter-thread-reader"
>
  <ToolHero
    title="X (Twitter) Thread Reader"
    subtitle="Unroll a thread into one clean page — then copy it or export to Markdown, TXT, HTML or PDF. Free, no X login required."
  />

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <div class="flex gap-2" role="tablist" aria-label="Thread input mode">
      <button id="tr-tab-url" class="tr-tab rounded-full px-4 py-2 text-sm font-medium" data-active="true" aria-selected="true" role="tab">
        From post URL
      </button>
      <button id="tr-tab-paste" class="tr-tab rounded-full px-4 py-2 text-sm font-medium" data-active="false" aria-selected="false" role="tab">
        Paste text
      </button>
    </div>

    <div id="tr-panel-url" class="mt-5">
      <form id="tr-form" class="flex flex-col gap-3 sm:flex-row">
        <input
          id="tr-url"
          aria-label="Post URL"
          type="text"
          inputmode="url"
          class="w-full flex-1 rounded-xl border border-slate-300 px-4 py-3 font-mono text-sm focus:border-brand focus:outline-none"
          placeholder="https://x.com/username/status/1234567890123456789"
          autocomplete="off"
          spellcheck="false"
        />
        <button
          type="submit"
          id="tr-btn"
          class="rounded-xl bg-brand px-8 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark disabled:opacity-50"
        >
          Unroll
        </button>
      </form>
      <p class="mt-2 text-xs text-slate-500">
        Best-effort via X's free embed endpoint. If a thread can't be unrolled, use the Paste mode.
      </p>
    </div>

    <div id="tr-panel-paste" class="mt-5 hidden">
      <label for="tr-text" class="mb-2 block text-sm font-medium text-slate-700">
        Thread text — separate posts with <code class="rounded bg-slate-100 px-1">---</code> on its own line (or lines like <code class="rounded bg-slate-100 px-1">1/</code>)
      </label>
      <textarea
        id="tr-text"
          aria-label="Thread text"
        rows="8"
        class="w-full rounded-xl border border-slate-300 p-4 font-mono text-sm leading-relaxed focus:border-brand focus:outline-none"
        placeholder={'First post of my thread...\n---\nSecond post, more detail...\n---\nWrapping up!'}
      ></textarea>
      <button
        id="tr-parse"
        class="mt-3 rounded-xl bg-brand px-8 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark"
      >
        Read thread
      </button>
    </div>

    <div id="tr-error" class="mt-4 hidden rounded-xl bg-red-50 px-4 py-3 text-sm text-red-600"></div>
    <div id="tr-partial" class="mt-4 hidden rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-700"></div>
    <div id="tr-single-hint" class="mt-4 hidden rounded-xl bg-sky-50 px-4 py-3 text-sm text-sky-800">
      Only got one post? If this is the <strong>start</strong> of a thread, paste the link to the
      <strong>last</strong> post instead — the reader unrolls threads backwards and needs a post
      that has replies above it.
    </div>

    <div id="tr-actions" class="mt-5 hidden flex-wrap items-center gap-2">
      <button data-tr-export="copy" class="tr-exp rounded-full border border-slate-300 px-4 py-2 text-xs font-medium text-slate-600 hover:border-brand hover:text-brand">Copy all</button>
      <button data-tr-export="md" class="tr-exp rounded-full border border-slate-300 px-4 py-2 text-xs font-medium text-slate-600 hover:border-brand hover:text-brand">Copy Markdown</button>
      <button data-tr-export="txt" class="tr-exp rounded-full border border-slate-300 px-4 py-2 text-xs font-medium text-slate-600 hover:border-brand hover:text-brand">Export TXT</button>
      <button data-tr-export="mdfile" class="tr-exp rounded-full border border-slate-300 px-4 py-2 text-xs font-medium text-slate-600 hover:border-brand hover:text-brand">Export .md</button>
      <button data-tr-export="html" class="tr-exp rounded-full bg-brand px-4 py-2 text-xs font-semibold text-white hover:bg-brand-dark">Export HTML</button>
      <button data-tr-export="pdf" class="tr-exp rounded-full border border-slate-300 px-4 py-2 text-xs font-medium text-slate-600 hover:border-brand hover:text-brand">Export PDF</button>
    </div>

    <div id="tr-tweets" class="mt-6 space-y-4"></div>
  </section>

  <AdSlot />

  <section class="mt-12">
    <h2 class="text-xl font-bold">Read, save and repurpose X threads</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="font-semibold">One clean page</p>
        <p class="mt-1 text-sm text-slate-600">
          Threads are written post by post, 1/ 2/ 3/… The reader stitches them back together so
          you can actually read them.
        </p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="font-semibold">Export anywhere</p>
        <p class="mt-1 text-sm text-slate-600">
          Markdown for Notion and Obsidian, TXT for anything, or a standalone HTML file that
          keeps the formatting.
        </p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="font-semibold">Nothing stored</p>
        <p class="mt-1 text-sm text-slate-600">
          Unrolled threads pass through our lightweight API and are cached for minutes, never
          archived. There's no account to tie them to.
        </p>
      </div>
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-bold">How to unroll a thread</h2>
    <ol class="mt-4 grid gap-4 sm:grid-cols-3">
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-bold text-brand">Step 1</p>
        <p class="mt-1 font-medium">Get the thread</p>
        <p class="mt-1 text-sm text-slate-600">
          Copy the link to any post in the thread — the reader walks the reply chain backwards, so
          the last post works best. Only have the text? Switch to the Paste mode instead.
        </p>
      </li>
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-bold text-brand">Step 2</p>
        <p class="mt-1 font-medium">Unroll it</p>
        <p class="mt-1 text-sm text-slate-600">
          Press Unroll and the reader collects the posts it can reach. If the chain can't be
          followed, the Paste mode always works.
        </p>
      </li>
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-bold text-brand">Step 3</p>
        <p class="mt-1 font-medium">Read or export</p>
        <p class="mt-1 text-sm text-slate-600">
          Read the whole thing on one page, copy it, or export to Markdown, TXT, HTML or PDF.
        </p>
      </li>
    </ol>
  </section>

  <Faq items={faq} />

  <section class="mt-12">
    <h2 class="text-xl font-bold">Related tools</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-3">
      {
        related.map((t) => (
          <li>
            <a href={t.slug} class="block rounded-xl border border-slate-200 bg-white p-4 text-sm font-medium hover:border-brand">
              {t.name} <span class="text-slate-400">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  import { extractTweetId, fetchThread, wireMediaImg, type TweetData } from '../lib/api';
  import { bookmarkToggleButton, type BookmarkItem } from '../lib/bookmark-store';

  const tabUrl = document.getElementById('tr-tab-url') as HTMLButtonElement;
  const tabPaste = document.getElementById('tr-tab-paste') as HTMLButtonElement;
  const panelUrl = document.getElementById('tr-panel-url')!;
  const panelPaste = document.getElementById('tr-panel-paste')!;
  const form = document.getElementById('tr-form') as HTMLFormElement;
  const urlInput = document.getElementById('tr-url') as HTMLInputElement;
  const btn = document.getElementById('tr-btn') as HTMLButtonElement;
  const pasteBtn = document.getElementById('tr-parse') as HTMLButtonElement;
  const textarea = document.getElementById('tr-text') as HTMLTextAreaElement;
  const errorBox = document.getElementById('tr-error')!;
  const partialBox = document.getElementById('tr-partial')!;
  const singleHint = document.getElementById('tr-single-hint')!;
  const actions = document.getElementById('tr-actions')!;
  const tweetsEl = document.getElementById('tr-tweets')!;

  interface SimpleMedia {
    poster: string;
    label: string; // 'Video' | 'GIF'
    postUrl?: string;
  }

  interface SimpleImage {
    src: string;
    w?: number;
    h?: number;
  }

  interface SimpleTweet {
    text: string;
    author?: string;
    handle?: string;
    date?: string;
    images?: SimpleImage[];
    media?: SimpleMedia[]; // videos / GIFs: poster thumbnail, linked out to X
  }

  let thread: SimpleTweet[] = [];
  let threadTitle = '';
  let threadSaveBtn: HTMLButtonElement | null = null;

  // --- mode switching -------------------------------------------------------
  function setMode(mode: 'url' | 'paste') {
    for (const [tab, active] of [
      [tabUrl, mode === 'url'],
      [tabPaste, mode === 'paste'],
    ] as const) {
      tab.dataset.active = String(active);
      tab.setAttribute('aria-selected', String(active));
      tab.className =
        'tr-tab rounded-full px-4 py-2 text-sm font-medium ' +
        (active ? 'bg-brand text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200');
    }
    panelUrl.classList.toggle('hidden', mode !== 'url');
    panelPaste.classList.toggle('hidden', mode !== 'paste');
  }
  tabUrl.addEventListener('click', () => setMode('url'));
  tabPaste.addEventListener('click', () => setMode('paste'));
  setMode('url');

  // --- rendering -------------------------------------------------------------
  const el = (tag: string, cls?: string): HTMLElement => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    return n;
  };

  function render() {
    tweetsEl.replaceChildren();
    if (!thread.length) {
      actions.classList.add('hidden');
      actions.classList.remove('flex');
      return;
    }
    actions.classList.remove('hidden');
    actions.classList.add('flex');

    thread.forEach((t, i) => {
      const card = el('article', 'rounded-xl border border-slate-200 p-4');
      const head = el('div', 'flex items-baseline gap-2');
      const num = el('span', 'text-sm font-bold text-brand');
      num.textContent = `${i + 1}/${thread.length}`;
      head.appendChild(num);
      if (t.handle) {
        const who = el('span', 'text-xs text-slate-500');
        who.textContent = t.author ? `${t.author} (@${t.handle})` : `@${t.handle}`;
        head.appendChild(who);
      }
      if (t.date) {
        const when = el('span', 'ml-auto text-xs text-slate-500');
        when.textContent = t.date;
        head.appendChild(when);
      }
      card.appendChild(head);

      const body = el('p', 'mt-2 whitespace-pre-wrap text-sm leading-relaxed text-slate-700');
      body.textContent = t.text;
      card.appendChild(body);

      if (t.images?.length) card.appendChild(buildImages(t.images));
      for (const m of t.media ?? []) card.appendChild(buildVideoCard(m));
      tweetsEl.appendChild(card);
    });
  }

  /** Videos and GIFs are not inlined (heavy files, and X's CDN is
   * unreachable on some networks): show the poster thumbnail with a badge
   * that opens the post on X, where the clip plays. */
  function buildVideoCard(m: SimpleMedia): HTMLElement {
    const wrap = el(m.postUrl ? 'a' : 'div', 'relative mt-3 block overflow-hidden rounded-lg bg-slate-100');
    if (m.postUrl) {
      const a = wrap as HTMLAnchorElement;
      a.href = m.postUrl;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
    }
    const img = document.createElement('img');
    img.alt = `${m.label} thumbnail`;
    img.loading = 'lazy';
    img.className = 'max-h-80 w-full object-contain';
    wireMediaImg(img, m.poster, 'thread-video');
    wrap.appendChild(img);
    const badge = el(
      'span',
      'absolute left-3 top-3 rounded-full bg-black/70 px-2.5 py-1 text-xs font-medium text-white'
    );
    badge.textContent = m.postUrl ? `${m.label} · watch on X ↗` : m.label;
    wrap.appendChild(badge);
    return wrap;
  }

  /** First photo across the thread, used as the saved snapshot's thumbnail. */
  function firstPostThumb(tweets: TweetData[]): string {
    for (const p of tweets) {
      const photo = p.media.find((m) => m.type === 'photo');
      if (photo) return photo.url;
    }
    return '';
  }

  /** Justified photo rows: images in a row share one height and each width
   * follows its natural aspect (flex-grow = w/h once loaded), so nothing is
   * cropped and no letterbox bars appear. Two per row; a leftover image
   * renders full width. */
  function buildImages(imgs: NonNullable<SimpleTweet['images']>): HTMLElement {
    const wrap = el('div', 'mt-3 space-y-2');
    for (let i = 0; i < imgs.length; i += 2) {
      const div = el('div', 'flex gap-2');
      for (const info of imgs.slice(i, i + 2)) {
        const img = document.createElement('img');
        img.alt = 'Thread media';
        img.loading = 'lazy';
        img.className = 'min-w-0 rounded-lg bg-slate-100';
        img.style.flex = '1 1 0%';
        img.style.height = 'auto';
        // reserve the box before the pixels arrive: no layout jump
        if (info.w && info.h) img.style.aspectRatio = `${info.w} / ${info.h}`;
        wireMediaImg(img, info.src, 'thread-media');
        img.addEventListener('load', () => {
          img.style.flexGrow = String(img.naturalWidth / (img.naturalHeight || 1));
        });
        div.appendChild(img);
      }
      wrap.appendChild(div);
    }
    return wrap;
  }

  // --- data sources -----------------------------------------------------------
  function showError(msg: string) {
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
  }
  function hideMessages() {
    errorBox.classList.add('hidden');
    partialBox.classList.add('hidden');
    singleHint.classList.add('hidden');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideMessages();
    const id = extractTweetId(urlInput.value);
    if (!id) {
      showError("That doesn't look like a post link. Paste something like https://x.com/user/status/123…");
      return;
    }
    btn.disabled = true;
    btn.textContent = 'Unrolling…';
    try {
      const data = await fetchThread(id);
      thread = data.tweets.map((t: TweetData) => ({
        text: t.text,
        author: t.user?.name,
        handle: t.user?.screenName,
        date: t.createdAt?.slice(0, 10),
        images: t.media
          .filter((m) => m.type === 'photo')
          .map((m) => ({ src: m.url, w: m.width, h: m.height })),
        media: t.media
          .filter((m) => m.type === 'video' || m.type === 'animated_gif')
          .map((m) => ({
            poster: m.url,
            label: m.type === 'animated_gif' ? 'GIF' : 'Video',
            postUrl: t.url,
          })),
      }));
      const first = data.tweets[0];
      threadTitle = first?.user?.screenName
        ? `Thread by ${first.user.name} (@${first.user.screenName})`
        : 'Thread';
      render();
      // one-click "save the whole thread" into the local bookmark library
      if (first) {
        const snapshot: BookmarkItem = {
          id: first.id,
          url: first.url,
          author: first.user?.name ?? '',
          handle: first.user?.screenName ?? '',
          text: data.tweets.map((p) => p.text).join('\n\n'),
          mediaType: 'thread',
          thumb: firstPostThumb(data.tweets),
          savedAt: Date.now(),
          tags: ['thread'],
          note: `${data.tweets.length} post${data.tweets.length > 1 ? 's' : ''}`,
        };
        threadSaveBtn?.remove();
        threadSaveBtn = bookmarkToggleButton(snapshot);
        actions.prepend(threadSaveBtn);
      }
      if (data.partial && data.tweets.length <= 1) {
        partialBox.textContent =
          "Couldn't follow the reply chain for this post (X's embed endpoint doesn't expose it). Copy the thread text and use the Paste mode instead — all exports still work.";
        partialBox.classList.remove('hidden');
      } else if (data.partial) {
        partialBox.textContent = 'Partially unrolled: some posts in the chain were unavailable (deleted or protected).';
        partialBox.classList.remove('hidden');
      } else if (data.tweets.length === 1) {
        singleHint.classList.remove('hidden');
      }
    } catch (err) {
      showError(
        (err instanceof Error ? err.message : 'Fetching failed.') +
          ' You can switch to the Paste mode to read and export the thread.'
      );
      thread = [];
      render();
    } finally {
      btn.disabled = false;
      btn.textContent = 'Unroll';
    }
  });

  function parsePasted(): SimpleTweet[] {
    const raw = textarea.value.trim();
    if (!raw) return [];
    let parts: string[];
    if (/^---\s*$/m.test(raw)) {
      parts = raw.split(/^---\s*$/m);
    } else if (/^\d+\/\s*$/m.test(raw)) {
      parts = raw.split(/^\d+\/\s*$/m);
    } else {
      parts = [raw];
    }
    return parts
      .map((p) => p.trim())
      .filter(Boolean)
      .map((p) => ({ text: p }));
  }

  pasteBtn.addEventListener('click', () => {
    hideMessages();
    thread = parsePasted();
    threadTitle = 'Thread';
    render();
    if (!thread.length) showError('Paste the thread text first (separate posts with --- lines).');
  });

  // --- exports ------------------------------------------------------------------
  function plainText(): string {
    return thread.map((t) => t.text).join('\n\n---\n\n');
  }
  function markdown(): string {
    const n = thread.length;
    const head = `# ${threadTitle}\n\n> Unrolled with TwitterTools — twittertools.com\n`;
    return (
      head +
      '\n' +
      thread
        .map((t, i) => {
          // photos embed as standard Markdown images (permanent CDN links);
          // videos/GIFs become links, since .md files can't carry video
          const media = [
            ...(t.images ?? []).map((im) => `\n\n![media](${im.src})`),
            ...(t.media ?? []).map((m) =>
              m.postUrl ? `\n\n[${m.label} — watch on X](${m.postUrl})` : `\n\n[${m.label}]`
            ),
          ].join('');
          return `**${i + 1}/${n}**\n\n${t.text}${media}`;
        })
        .join('\n\n---\n\n') +
      '\n'
    );
  }
  function htmlDoc(): string {
    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const items = thread
      .map((t, i) => {
        const who = t.handle ? `<span class="who">${esc(t.author ?? '')} (@${esc(t.handle)})</span>` : '';
        const imgs = (t.images ?? [])
          .map(
            (im) =>
              `<img src="${esc(im.src)}" alt="" referrerpolicy="no-referrer" loading="lazy"${im.w && im.h ? ` width="${im.w}" height="${im.h}"` : ''}>`
          )
          .join('');
        const vids = (t.media ?? [])
          .map((m) => {
            const img = `<img src="${esc(m.poster)}" alt="${esc(m.label)}" referrerpolicy="no-referrer" loading="lazy">`;
            const tag = `<span class="tag">${esc(m.postUrl ? `${m.label} — watch on X ↗` : m.label)}</span>`;
            return m.postUrl
              ? `<a class="vid" href="${esc(m.postUrl)}" target="_blank" rel="noopener noreferrer">${img}${tag}</a>`
              : `<span class="vid">${img}${tag}</span>`;
          })
          .join('');
        return `<article><h2>${i + 1}/${thread.length} ${who}</h2><p>${esc(t.text).replace(/\n/g, '<br>')}</p>${imgs}${vids}</article>`;
      })
      .join('\n');
    return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc(threadTitle)}</title><style>body{font-family:system-ui,sans-serif;max-width:40rem;margin:2rem auto;padding:0 1rem;color:#0f1419}article{border:1px solid #e2e8f0;border-radius:12px;padding:1rem;margin-bottom:1rem}h2{font-size:.9rem;margin:0 0 .5rem}h2 .who{font-weight:400;color:#64748b;margin-left:.5rem}p{line-height:1.6;white-space:pre-wrap;margin:0}img{max-width:100%;height:auto;border-radius:8px;margin-top:.5rem}.vid{position:relative;display:block;margin-top:.5rem}.vid img{margin-top:0}.vid .tag{position:absolute;left:.75rem;top:.75rem;background:rgba(0,0,0,.65);color:#fff;font-size:.75rem;padding:.2rem .6rem;border-radius:9999px}footer{color:#94a3b8;font-size:.8rem;margin-top:2rem}</style></head><body><h1>${esc(threadTitle)}</h1>${items}<footer>Unrolled with <a href="https://twittertools.com">TwitterTools</a></footer></body></html>`;
  }

  function download(filename: string, content: string, type: string) {
    const blob = new Blob([content], { type });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 5000);
  }

  /** PDF export = the HTML export in a print-ready window; the browser's "Save as PDF" does the rest. */
  function pdfDoc(): string {
    const printCss = '<style>@page{margin:14mm}@media print{body{margin:1rem}}</style>';
    const autoprint = '<script>window.addEventListener("load",function(){setTimeout(function(){window.print()},400)})<\/script>';
    return htmlDoc().replace('</head>', printCss + autoprint + '</head>');
  }

  document.querySelectorAll<HTMLButtonElement>('.tr-exp').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!thread.length) return;
      const stamp = new Date().toISOString().slice(0, 10);
      switch (btn.dataset.trExport) {
        case 'copy':
          await navigator.clipboard.writeText(plainText());
          break;
        case 'md':
          await navigator.clipboard.writeText(markdown());
          break;
        case 'txt':
          download(`thread-${stamp}.txt`, plainText(), 'text/plain');
          break;
        case 'mdfile':
          download(`thread-${stamp}.md`, markdown(), 'text/markdown');
          break;
        case 'html':
          download(`thread-${stamp}.html`, htmlDoc(), 'text/html');
          break;
        case 'pdf': {
          const w = window.open('', '_blank');
          if (!w) {
            showError('The PDF export opens a new window — please allow pop-ups for this site and try again.');
            return;
          }
          w.opener = null;
          w.document.write(pdfDoc());
          w.document.close();
          break;
        }
      }
      const old = btn.textContent;
      btn.textContent = '✓ Done';
      setTimeout(() => (btn.textContent = old), 1200);
    });
  });

  // Deep link support (e.g. from the homepage router): /twitter-thread-reader?url=<post url>
  const deepLink = new URLSearchParams(window.location.search).get('url');
  if (deepLink && extractTweetId(deepLink)) {
    urlInput.value = deepLink;
    form.requestSubmit();
  }
</script>
