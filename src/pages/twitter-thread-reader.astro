---
import Base from '../layouts/Base.astro';
import ToolHero from '../components/ToolHero.astro';
import Faq from '../components/Faq.astro';
import AdSlot from '../components/AdSlot.astro';
import { TOOLS } from '../lib/tools';

const faq = [
  {
    q: 'How does the thread reader work?',
    a: 'TwitterTools follows the reply chain backwards from the post you paste — so the thread\'s last post unrolls the whole thing. X no longer lets unauthenticated tools list a post\'s replies, so the reader can\'t walk forwards from the first post; if that\'s the link you have, copy the thread\'s text — or its post links, one per line — and use the Paste mode instead — all reading and export features still work.',
  },
  {
    q: 'Can I export a thread as Markdown?',
    a: 'Yes — exports read like a proper write-up: title, author and date at the top, then the posts flowing as one piece, with photos embedded as images and videos linked. Any post can be unticked before exporting to drop it (handy for accidental duplicates). Ready for Notion, Obsidian, GitHub or any static-site generator. TXT and standalone HTML exports are there too, and the PDF export opens your browser\'s print dialog — choose "Save as PDF". There\'s also a Copy for AI button that formats the selection with author, date and source for pasting straight into ChatGPT, Claude or Gemini.',
  },
  {
    q: 'Do I need to log in to X?',
    a: 'Never. The reader only fetches public posts through X\'s embed endpoint. No OAuth, no cookies, no account access of any kind.',
  },
  {
    q: 'Why can\'t some threads be unrolled?',
    a: 'Deleted posts, protected accounts and occasional restrictions on X\'s embed endpoint can break the chain. X also only exposes each post\'s parent — not its replies — which is why the reader walks backwards and a full unroll needs the thread\'s last post. The tool tells you when a thread is only partially available and offers the paste mode as a reliable fallback.',
  },
  {
    q: 'Does it work with X Articles (long-form posts)?',
    a: 'Partly. X Articles are a separate long-form format, and without a login X only exposes their title, preview and cover image — so the reader shows exactly that and links to the original on X. The full body isn\'t available to any logged-out tool.',
  },
  {
    q: 'Is this like Thread Reader App?',
    a: 'It\'s the same idea — unroll, read, export — but independent, free, and combined with the rest of the TwitterTools toolkit. No account required and no storage of what you unroll.',
  },
];

const related = TOOLS.filter((t) => t.slug !== '/twitter-thread-reader').slice(0, 3);

  const tool = TOOLS.find((t) => t.slug === '/twitter-thread-reader')!;
  const toolLd = {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: tool.name,
    url: 'https://twittertools.com/twitter-thread-reader/',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: tool.tagline,
  };
---

<Base
  title="X (Twitter) Thread Reader — Unroll & Export to Markdown | Free"
  description="Unroll any public X (Twitter) thread into one readable page. Copy it as plain text or AI-ready input, or export as Markdown, TXT, HTML or PDF. Free, no login required."
  path="/twitter-thread-reader"
    jsonLd={[toolLd]}
>
  <ToolHero
    title="X (Twitter) Thread Reader"
    subtitle="Unroll a thread into one clean page — then copy it as plain text or AI-ready input, or export to Markdown, TXT, HTML or PDF. Free, no X login required."
  />

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <div class="flex gap-2" role="tablist" aria-label="Thread input mode">
      <button id="tr-tab-url" class="tr-tab rounded-full px-4 py-2 text-sm font-medium" data-active="true" aria-selected="true" role="tab">
        From post URL
      </button>
      <button id="tr-tab-paste" class="tr-tab rounded-full px-4 py-2 text-sm font-medium" data-active="false" aria-selected="false" role="tab">
        Paste mode
      </button>
    </div>

    <div id="tr-panel-url" class="mt-5">
      <form id="tr-form" class="flex flex-col gap-3 sm:flex-row">
        <input
          id="tr-url"
          aria-label="Post URL"
          type="text"
          inputmode="url"
          class="w-full flex-1 rounded-xl border border-slate-300 px-4 py-3 font-mono text-sm focus:border-brand focus:outline-none"
          placeholder="https://x.com/username/status/1234567890123456789"
          autocomplete="off"
          spellcheck="false"
        />
        <button
          type="submit"
          id="tr-btn"
          class="rounded-xl bg-brand px-8 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark disabled:opacity-50"
        >
          Unroll
        </button>
      </form>
      <p class="mt-2 text-xs text-slate-500">
        The reader follows replies backwards from the post you paste — the thread's
        <strong>last</strong> post gives the full thread. If a chain can't be followed, use the Paste mode.
      </p>
    </div>

    <div id="tr-panel-paste" class="mt-5 hidden">
      <label for="tr-text" class="mb-2 block text-sm font-medium text-slate-700">
        Thread text — separate posts with <code class="rounded bg-slate-100 px-1">---</code> on its
        own line (or lines like <code class="rounded bg-slate-100 px-1">1/</code>). A list of post
        links, one per line, works too — they're fetched in that order, duplicates removed.
      </label>
      <textarea
        id="tr-text"
          aria-label="Thread text or post links"
        rows="8"
        class="w-full rounded-xl border border-slate-300 p-4 font-mono text-sm leading-relaxed focus:border-brand focus:outline-none"
        placeholder={'Post links, one per line:\nhttps://x.com/who/status/1234…\nhttps://x.com/who/status/5678…\n\n— or thread text with --- lines between posts'}
      ></textarea>
      <button
        id="tr-parse"
        class="mt-3 rounded-xl bg-brand px-8 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark"
      >
        Read thread
      </button>
    </div>

    <div id="tr-error" class="mt-4 hidden rounded-xl bg-red-50 px-4 py-3 text-sm text-red-600"></div>
    <div id="tr-partial" class="mt-4 hidden rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-700"></div>
    <div id="tr-single-hint" class="mt-4 hidden rounded-xl bg-sky-50 px-4 py-3 text-sm text-sky-800">
      Only got one post? If this is the <strong>start</strong> of a thread, paste the link to the
      <strong>last</strong> post instead — the reader unrolls threads backwards and needs a post
      that has replies above it.
    </div>

    <div id="tr-actions" class="mt-5 hidden flex-wrap items-center gap-2">
      <button data-tr-export="copy" class="tr-exp rounded-full border border-slate-300 px-4 py-2 text-xs font-medium text-slate-600 hover:border-brand hover:text-brand">Copy all</button>
      <button data-tr-export="md" class="tr-exp rounded-full border border-slate-300 px-4 py-2 text-xs font-medium text-slate-600 hover:border-brand hover:text-brand">Copy Markdown</button>
      <button data-tr-export="ai" class="tr-exp rounded-full border border-slate-300 px-4 py-2 text-xs font-medium text-slate-600 hover:border-brand hover:text-brand">Copy for AI</button>
      <button data-tr-export="txt" class="tr-exp rounded-full border border-slate-300 px-4 py-2 text-xs font-medium text-slate-600 hover:border-brand hover:text-brand">Export TXT</button>
      <button data-tr-export="mdfile" class="tr-exp rounded-full border border-slate-300 px-4 py-2 text-xs font-medium text-slate-600 hover:border-brand hover:text-brand">Export .md</button>
      <button data-tr-export="html" class="tr-exp rounded-full bg-brand px-4 py-2 text-xs font-semibold text-white hover:bg-brand-dark">Export HTML</button>
      <button data-tr-export="pdf" class="tr-exp rounded-full border border-slate-300 px-4 py-2 text-xs font-medium text-slate-600 hover:border-brand hover:text-brand">Export PDF</button>
    </div>

    <p
      id="tr-sel-hint"
      class="mt-2 hidden flex-wrap items-center justify-end gap-x-2 text-right text-xs text-slate-400"
    >
      Untick a post to leave it out of the exports.
      <button
        id="tr-sel-all"
        class="hidden rounded-full border border-slate-300 px-2.5 py-0.5 text-[11px] font-medium text-slate-500 transition hover:border-brand hover:text-brand"
        >Select all</button
      >
    </p>

    <div id="tr-tweets" class="mt-6 space-y-5"></div>
  </section>

  <AdSlot />

  <section class="mt-12">
    <h2 class="text-xl font-bold">Read, save and repurpose X threads</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="font-semibold">One clean page</p>
        <p class="mt-1 text-sm text-slate-600">
          Threads are written post by post, 1/ 2/ 3/… The reader stitches them back together so
          you can actually read them.
        </p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="font-semibold">Export anywhere</p>
        <p class="mt-1 text-sm text-slate-600">
          Markdown for Notion and Obsidian, TXT for anything, a standalone HTML file that keeps
          the formatting — or a one-click copy formatted for ChatGPT and Claude.
        </p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="font-semibold">Nothing stored</p>
        <p class="mt-1 text-sm text-slate-600">
          Unrolled threads pass through our lightweight API and are cached for minutes, never
          archived. There's no account to tie them to.
        </p>
      </div>
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-bold">How to unroll a thread</h2>
    <ol class="mt-4 grid gap-4 sm:grid-cols-3">
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-bold text-brand">Step 1</p>
        <p class="mt-1 font-medium">Get the thread</p>
        <p class="mt-1 text-sm text-slate-600">
          Copy the link to the thread's <strong>last</strong> post — the reader walks the reply
          chain backwards from there, so one link covers the whole thread. Only have the text?
          Switch to the Paste mode instead.
        </p>
      </li>
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-bold text-brand">Step 2</p>
        <p class="mt-1 font-medium">Unroll it</p>
        <p class="mt-1 text-sm text-slate-600">
          Press Unroll and the reader collects the posts it can reach. If the chain can't be
          followed, the Paste mode always works.
        </p>
      </li>
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-bold text-brand">Step 3</p>
        <p class="mt-1 font-medium">Read or export</p>
        <p class="mt-1 text-sm text-slate-600">
          Read the whole thing on one page, copy it as text or for AI, or export to Markdown, TXT,
          HTML or PDF.
        </p>
      </li>
    </ol>
  </section>

  <Faq items={faq} />

  <section class="mt-12">
    <h2 class="text-xl font-bold">Related tools</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-3">
      {
        related.map((t) => (
          <li>
            <a href={t.slug} class="block rounded-xl border border-slate-200 bg-white p-4 text-sm font-medium hover:border-brand">
              {t.name} <span class="text-slate-400">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  import { extractTweetId, fetchThread, fetchTweet, wireMediaImg, type TweetData } from '../lib/api';
  import { bookmarkToggleButton, type BookmarkItem } from '../lib/bookmark-store';

  const tabUrl = document.getElementById('tr-tab-url') as HTMLButtonElement;
  const tabPaste = document.getElementById('tr-tab-paste') as HTMLButtonElement;
  const panelUrl = document.getElementById('tr-panel-url')!;
  const panelPaste = document.getElementById('tr-panel-paste')!;
  const form = document.getElementById('tr-form') as HTMLFormElement;
  const urlInput = document.getElementById('tr-url') as HTMLInputElement;
  const btn = document.getElementById('tr-btn') as HTMLButtonElement;
  const pasteBtn = document.getElementById('tr-parse') as HTMLButtonElement;
  const textarea = document.getElementById('tr-text') as HTMLTextAreaElement;
  const errorBox = document.getElementById('tr-error')!;
  const partialBox = document.getElementById('tr-partial')!;
  const singleHint = document.getElementById('tr-single-hint')!;
  // innerHTML constants (static strings, no user data): the hint switches
  // between them per unroll, so set the content on every show
  const SINGLE_HINT_DEFAULT =
    'Only got one post? If this is the <strong>start</strong> of a thread, paste the link to the <strong>last</strong> post instead — the reader unrolls threads backwards and needs a post that has replies above it.';
  const SINGLE_HINT_ARTICLE =
    'This is an X Article, not a thread — without a login X only exposes its title and preview, so that is all the reader can show. Open <a class="font-semibold underline" href="ARTICLE_URL" target="_blank" rel="noopener">the article on X</a> to read the whole thing.';
  const actions = document.getElementById('tr-actions')!;
  const tweetsEl = document.getElementById('tr-tweets')!;
  const selHint = document.getElementById('tr-sel-hint')!;
  const selAll = document.getElementById('tr-sel-all') as HTMLButtonElement;

  interface SimpleMedia {
    poster: string;
    label: string; // 'Video' | 'GIF'
    postUrl?: string;
  }

  interface SimpleImage {
    src: string;
    w?: number;
    h?: number;
  }

  interface SimpleTweet {
    text: string;
    author?: string;
    handle?: string;
    date?: string;
    avatar?: string;
    url?: string;
    /** X Article (long-form): text is title + preview, media is the cover. */
    article?: boolean;
    /** Untick a post to leave it out of the exports (default: included). */
    sel?: boolean;
    images?: SimpleImage[];
    media?: SimpleMedia[]; // videos / GIFs: poster thumbnail, linked out to X
    /** Embedded quoted post, shown as a small inline card. */
    quoted?: { name: string; handle: string; text: string };
  }

  let thread: SimpleTweet[] = [];
  let threadTitle = '';
  let threadSaveBtn: HTMLButtonElement | null = null;

  // --- mode switching -------------------------------------------------------
  function setMode(mode: 'url' | 'paste') {
    for (const [tab, active] of [
      [tabUrl, mode === 'url'],
      [tabPaste, mode === 'paste'],
    ] as const) {
      tab.dataset.active = String(active);
      tab.setAttribute('aria-selected', String(active));
      tab.className =
        'tr-tab rounded-full px-4 py-2 text-sm font-medium ' +
        (active ? 'bg-brand text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200');
    }
    panelUrl.classList.toggle('hidden', mode !== 'url');
    panelPaste.classList.toggle('hidden', mode !== 'paste');
  }
  tabUrl.addEventListener('click', () => setMode('url'));
  tabPaste.addEventListener('click', () => setMode('paste'));
  setMode('url');

  // --- rendering -------------------------------------------------------------
  const el = (tag: string, cls?: string): HTMLElement => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    return n;
  };

  /** Posts included in exports (everything unless unticked). */
  function selected(): SimpleTweet[] {
    return thread.filter((t) => t.sel !== false);
  }

  selAll.addEventListener('click', () => {
    for (const t of thread) t.sel = true;
    render();
  });

  /** Pointer-based row reordering: press the ⠿ handle and drag — rows swap
   * live (DOM and the thread array move together); the render() on release
   * renumbers the 1/N markers. Works for mouse and touch (touch-action:none
   * keeps the page from scrolling while dragging from the handle). */
  function wireDrag(handle: HTMLElement, row: HTMLElement) {
    handle.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      const rows = Array.from(tweetsEl.querySelectorAll<HTMLElement>(':scope > article'));
      let cur = rows.indexOf(row);
      if (cur < 0) return;
      try {
        row.setPointerCapture(e.pointerId);
      } catch {
        /* non-capturing pointers still bubble to window */
      }
      row.classList.add('opacity-60');
      document.body.style.cursor = 'grabbing';
      const onMove = (ev: PointerEvent) => {
        for (let j = 0; j < rows.length; j++) {
          if (j === cur) continue;
          const b = rows[j].getBoundingClientRect();
          const mid = b.top + b.height / 2;
          if ((j < cur && ev.clientY < mid) || (j > cur && ev.clientY > mid)) {
            tweetsEl.insertBefore(row, j < cur ? rows[j] : rows[j].nextSibling);
            [thread[cur], thread[j]] = [thread[j], thread[cur]];
            [rows[cur], rows[j]] = [rows[j], rows[cur]];
            cur = j;
            break;
          }
        }
      };
      const onUp = () => {
        window.removeEventListener('pointermove', onMove);
        window.removeEventListener('pointerup', onUp);
        row.classList.remove('opacity-60');
        document.body.style.cursor = '';
        render();
      };
      window.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', onUp);
    });
  }

  function render() {
    tweetsEl.replaceChildren();
    if (!thread.length) {
      actions.classList.add('hidden');
      actions.classList.remove('flex');
      selHint.classList.add('hidden');
      selHint.classList.remove('flex');
      return;
    }
    actions.classList.remove('hidden');
    actions.classList.add('flex');
    const multi = thread.length > 1;
    selHint.classList.toggle('hidden', !multi);
    if (multi) selHint.classList.add('flex');
    selAll.classList.toggle('hidden', selected().length === thread.length);

    const first = thread[0];

    // article byline: author, date and post count appear once at the top,
    // not repeated on every post
    if (first.handle) {
      const by = el('div', 'flex items-center gap-3 border-b border-slate-100 pb-5');
      if (first.avatar) {
        const av = document.createElement('img');
        av.alt = '';
        av.referrerPolicy = 'no-referrer';
        av.className = 'h-11 w-11 shrink-0 rounded-full bg-slate-100 object-cover';
        wireMediaImg(av, first.avatar, 'thread-avatar');
        by.appendChild(av);
      }
      const id = el('div', 'min-w-0');
      const name = el('div', 'truncate text-sm font-semibold text-slate-900');
      name.textContent = first.author ?? `@${first.handle}`;
      const sub = el('div', 'mt-0.5 text-xs text-slate-500');
      sub.textContent = [
        `@${first.handle}`,
        fmtDate(first.date),
        `${thread.length} post${thread.length > 1 ? 's' : ''}`,
      ]
        .filter(Boolean)
        .join(' · ');
      id.append(name, sub);
      by.appendChild(id);
      if (first.url) {
        const open = document.createElement('a');
        open.href = first.url;
        open.target = '_blank';
        open.rel = 'noopener noreferrer';
        open.className = 'ml-auto shrink-0 text-xs text-slate-400 hover:text-brand';
        open.textContent = 'View on X ↗';
        by.appendChild(open);
      }
      tweetsEl.appendChild(by);
    }

    thread.forEach((t, i) => {
      const row = el('article', 'flex gap-3');
      let marker: HTMLElement | null = null;
      if (multi) {
        // drag handle first, then the 1/N marker
        const handle = el(
          'span',
          '-ml-1 w-4 shrink-0 cursor-grab select-none self-stretch text-base leading-none text-slate-300 hover:text-slate-500 active:cursor-grabbing'
        );
        handle.textContent = '⠿';
        handle.style.touchAction = 'none';
        handle.setAttribute('aria-hidden', 'true');
        handle.title = 'Drag to reorder';
        row.appendChild(handle);
        wireDrag(handle, row);
        marker = el(
          'span',
          'w-10 shrink-0 pt-[3px] text-right text-[11px] tabular-nums text-slate-400'
        );
        marker.textContent = `${i + 1}/${thread.length}`;
        row.appendChild(marker);
      }
      const col = el('div', 'min-w-0 flex-1');
      // reply chains can cross accounts; attribute those posts inline
      if (t.handle && first.handle && t.handle !== first.handle) {
        const who = el('p', 'mb-1 text-xs font-medium text-slate-500');
        who.textContent = t.author ? `${t.author} (@${t.handle})` : `@${t.handle}`;
        col.appendChild(who);
      }
      const body = el('p', 'whitespace-pre-wrap text-[15px] leading-7 text-slate-800');
      body.textContent = t.text;
      col.appendChild(body);

      // embedded quoted post, X-style small card
      if (t.quoted) {
        const q = el('blockquote', 'mt-2 rounded-r-lg border-l-2 border-slate-300 bg-slate-50 py-2 pl-3 pr-2');
        const qWho = el('p', 'text-xs text-slate-500');
        qWho.textContent = `${t.quoted.name} @${t.quoted.handle}`;
        const qText = el('p', 'mt-1 line-clamp-3 whitespace-pre-wrap text-xs leading-relaxed text-slate-600');
        qText.textContent = t.quoted.text;
        q.append(qWho, qText);
        col.appendChild(q);
      }

      if (t.images?.length) col.appendChild(buildImages(t.images));
      for (const m of t.media ?? []) col.appendChild(buildVideoCard(m));
      row.appendChild(col);

      if (multi) {
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.checked = t.sel !== false;
        cb.className = 'mt-1.5 h-4 w-4 shrink-0 accent-brand';
        cb.setAttribute('aria-label', `Include post ${i + 1} in exports`);
        cb.addEventListener('change', () => {
          t.sel = cb.checked;
          col.classList.toggle('opacity-40', !cb.checked);
          marker?.classList.toggle('opacity-40', !cb.checked);
          selAll.classList.toggle('hidden', selected().length === thread.length);
        });
        if (!cb.checked) {
          col.classList.add('opacity-40');
          marker?.classList.add('opacity-40');
        }
        row.appendChild(cb);
      }
      tweetsEl.appendChild(row);
    });
  }

  /** Videos and GIFs are not inlined (heavy files, and X's CDN is
   * unreachable on some networks): show the poster thumbnail with a badge
   * that opens the post on X, where the clip plays. */
  function buildVideoCard(m: SimpleMedia): HTMLElement {
    const wrap = el(m.postUrl ? 'a' : 'div', 'relative mt-3 block overflow-hidden rounded-lg bg-slate-100');
    if (m.postUrl) {
      const a = wrap as HTMLAnchorElement;
      a.href = m.postUrl;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
    }
    const img = document.createElement('img');
    img.alt = `${m.label} thumbnail`;
    img.loading = 'lazy';
    img.className = 'max-h-80 w-full object-contain';
    wireMediaImg(img, m.poster, 'thread-video');
    wrap.appendChild(img);
    const badge = el(
      'span',
      'absolute left-3 top-3 rounded-full bg-black/70 px-2.5 py-1 text-xs font-medium text-white'
    );
    badge.textContent = m.postUrl ? `${m.label} · watch on X ↗` : m.label;
    wrap.appendChild(badge);
    return wrap;
  }

  /** First photo across the thread, used as the saved snapshot's thumbnail. */
  function firstPostThumb(tweets: TweetData[]): string {
    for (const p of tweets) {
      const photo = p.media.find((m) => m.type === 'photo');
      if (photo) return photo.url;
    }
    return '';
  }

  /** Justified photo rows: images in a row share one height and each width
   * follows its natural aspect (flex-grow = w/h once loaded), so nothing is
   * cropped and no letterbox bars appear. Two per row; a leftover image
   * renders full width. */
  function buildImages(imgs: NonNullable<SimpleTweet['images']>): HTMLElement {
    const wrap = el('div', 'mt-3 space-y-2');
    for (let i = 0; i < imgs.length; i += 2) {
      const div = el('div', 'flex gap-2');
      for (const info of imgs.slice(i, i + 2)) {
        const img = document.createElement('img');
        img.alt = 'Thread media';
        img.loading = 'lazy';
        img.className = 'min-w-0 rounded-lg bg-slate-100';
        img.style.flex = '1 1 0%';
        img.style.height = 'auto';
        // reserve the box before the pixels arrive: no layout jump
        if (info.w && info.h) img.style.aspectRatio = `${info.w} / ${info.h}`;
        wireMediaImg(img, info.src, 'thread-media');
        img.addEventListener('load', () => {
          img.style.flexGrow = String(img.naturalWidth / (img.naturalHeight || 1));
        });
        div.appendChild(img);
      }
      wrap.appendChild(div);
    }
    return wrap;
  }

  // --- data sources -----------------------------------------------------------
  function showError(msg: string) {
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
  }
  function hideMessages() {
    errorBox.classList.add('hidden');
    partialBox.classList.add('hidden');
    singleHint.classList.add('hidden');
  }

  // --- shared adoption: fetched posts -> rendered thread + save button -------
  function toSimple(t: TweetData): SimpleTweet {
    return {
      text: t.text,
      author: t.user?.name,
      handle: t.user?.screenName,
      date: t.createdAt?.slice(0, 10),
      avatar: t.user?.avatar,
      url: t.url,
      article: t.article,
      sel: true,
      images: t.media
        .filter((m) => m.type === 'photo')
        .map((m) => ({ src: m.url, w: m.width, h: m.height })),
      media: t.media
        .filter((m) => m.type === 'video' || m.type === 'animated_gif')
        .map((m) => ({
          poster: m.url,
          label: m.type === 'animated_gif' ? 'GIF' : 'Video',
          postUrl: t.url,
        })),
      quoted: t.quoted
        ? {
            name: t.quoted.user?.name ?? 'Unknown',
            handle: t.quoted.user?.screenName ?? 'unknown',
            text: t.quoted.text,
          }
        : undefined,
    };
  }

  function adoptTweets(tweets: TweetData[]) {
    thread = tweets.map(toSimple);
    const first = tweets[0];
    threadTitle = first?.article
      ? (first.text.split('\n')[0] ?? 'Article')
      : first?.user?.screenName
        ? `Thread by ${first.user.name} (@${first.user.screenName})`
        : 'Thread';
    render();
    // one-click "save the whole thread" into the local bookmark library
    if (first) {
      const snapshot: BookmarkItem = {
        id: first.id,
        url: first.url,
        author: first.user?.name ?? '',
        handle: first.user?.screenName ?? '',
        text: tweets.map((p) => p.text).join('\n\n'),
        mediaType: first.article ? 'article' : 'thread',
        posts: tweets.map((p) => p.text),
        thumb: firstPostThumb(tweets),
        savedAt: Date.now(),
        tags: [],
        note: `${tweets.length} post${tweets.length > 1 ? 's' : ''}`,
      };
      threadSaveBtn?.remove();
      threadSaveBtn = bookmarkToggleButton(snapshot);
      actions.prepend(threadSaveBtn);
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideMessages();
    const id = extractTweetId(urlInput.value);
    if (!id) {
      showError("That doesn't look like a post link. Paste something like https://x.com/user/status/123…");
      return;
    }
    btn.disabled = true;
    btn.textContent = 'Unrolling…';
    try {
      const data = await fetchThread(id);
      adoptTweets(data.tweets);
      if (data.partial && data.tweets.length <= 1) {
        partialBox.textContent =
          "Couldn't follow the reply chain for this post (X's embed endpoint doesn't expose it). Copy the thread text and use the Paste mode instead — all exports still work.";
        partialBox.classList.remove('hidden');
      } else if (data.partial) {
        partialBox.textContent =
          data.reason === 'conversation_truncated'
            ? "X cut the conversation listing short — posts near the end may be missing. Pasting the thread's last post usually fetches the rest."
            : data.reason === 'replies_unavailable'
              ? "The rest of the thread couldn't be fetched right now, so what you see may be incomplete. Try again shortly, or paste the thread's last post."
              : 'Partially unrolled: some posts in the chain were unavailable (deleted or protected).';
        partialBox.classList.remove('hidden');
      } else if (data.tweets.length === 1) {
        const solo = data.tweets[0];
        singleHint.innerHTML = solo?.article
          ? SINGLE_HINT_ARTICLE.replace('ARTICLE_URL', (solo.url ?? 'https://x.com').replace(/"/g, '%22'))
          : SINGLE_HINT_DEFAULT;
        singleHint.classList.remove('hidden');
      }
    } catch (err) {
      showError(
        (err instanceof Error ? err.message : 'Fetching failed.') +
          ' You can switch to the Paste mode to read and export the thread.'
      );
      thread = [];
      render();
    } finally {
      btn.disabled = false;
      btn.textContent = 'Unroll';
    }
  });

  function parsePasted(): SimpleTweet[] {
    const raw = textarea.value.trim();
    if (!raw) return [];
    let parts: string[];
    if (/^---\s*$/m.test(raw)) {
      parts = raw.split(/^---\s*$/m);
    } else if (/^\d+\/\s*$/m.test(raw)) {
      parts = raw.split(/^\d+\/\s*$/m);
    } else {
      parts = [raw];
    }
    return parts
      .map((p) => p.trim())
      .filter(Boolean)
      .map((p) => ({ text: p, sel: true }));
  }

  /** A paste of post links (one per line; --- separator lines are ignored)
   * rather than thread text? True only when EVERY non-empty line contains a
   * status link — otherwise the input is thread text. Duplicate links
   * collapse to one. */
  function parseUrlList(): string[] | null {
    const lines = textarea.value
      .split('\n')
      .map((l) => l.trim())
      .filter((l) => l && !/^-{3,}$/.test(l));
    if (!lines.length) return null;
    const ids: string[] = [];
    for (const line of lines) {
      const id = extractTweetId(line);
      if (!id) return null;
      if (!ids.includes(id)) ids.push(id);
    }
    return ids;
  }

  /** Fetch pasted post links one by one (polite pacing keeps us under the
   * API rate limit) and adopt them as a thread, in the pasted order. */
  async function fetchUrlList(ids: string[]) {
    const batch = ids.slice(0, 50);
    const raw: TweetData[] = [];
    let failed = 0;
    pasteBtn.disabled = true;
    try {
      for (let i = 0; i < batch.length; i++) {
        pasteBtn.textContent = `Fetching ${i + 1}/${batch.length}…`;
        try {
          raw.push(await fetchTweet(batch[i]));
        } catch {
          failed++;
        }
        if (i < batch.length - 1) await new Promise((r) => setTimeout(r, 1100));
      }
    } finally {
      pasteBtn.disabled = false;
      pasteBtn.textContent = 'Read thread';
    }
    if (!raw.length) {
      showError("Couldn't fetch any of those posts — check the links or try again in a minute.");
      return;
    }
    adoptTweets(raw);
    const notes: string[] = [];
    if (ids.length > 50) notes.push('Only the first 50 links were read.');
    if (failed)
      notes.push(`Fetched ${raw.length} of ${batch.length} posts — the rest failed (deleted, restricted, or X's endpoint hiccupped).`);
    if (notes.length) {
      partialBox.textContent = notes.join(' ') + ' Drag posts to reorder, then export.';
      partialBox.classList.remove('hidden');
    }
  }

  pasteBtn.addEventListener('click', () => {
    hideMessages();
    const ids = parseUrlList();
    if (ids) {
      void fetchUrlList(ids);
      return;
    }
    thread = parsePasted();
    threadTitle = 'Thread';
    render();
    if (!thread.length)
      showError('Paste the thread text first (separate posts with --- lines), or paste post links, one per line.');
  });

  // --- exports ------------------------------------------------------------------
  function plainText(): string {
    return selected().map((t) => t.text).join('\n\n---\n\n');
  }

  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  /** "2026-09-28" → "Sep 28, 2026". Parsed from the string on purpose: a Date
   * object would shift the day across time zones (UTC midnight in UTC-5). */
  function fmtDate(iso?: string): string {
    const m = iso?.match(/^(\d{4})-(\d{2})-(\d{2})/);
    return m ? `${MONTHS[Number(m[2]) - 1]} ${Number(m[3])}, ${m[1]}` : (iso ?? '');
  }

  /** Article title: first meaningful line of the first selected post, minus a
   * leading "1/" marker (requires a space after the slash, so "1/2 of people"
   * survives) and minus trailing sentence punctuation. */
  function deriveTitle(): string {
    const raw = selected()[0]?.text.split('\n').find((l) => l.trim()) ?? '';
    const cleaned = raw
      .replace(/^\s*\d{1,3}\/\s+/, '')
      .trim()
      .replace(/[。．.!??！？…]+$/, '')
      .trim();
    const fallback = threadTitle || 'Thread';
    if (!cleaned) return fallback;
    return cleaned.length > 90 ? cleaned.slice(0, 90).replace(/\s+\S*$/, '') + '…' : cleaned;
  }

  function markdown(): string {
    const posts = selected();
    const first = posts[0];
    const lines: string[] = [`# ${deriveTitle()}`, ''];
    if (first?.handle) {
      const who = first.author
        ? `${first.author} ([@${first.handle}](https://x.com/${first.handle}))`
        : `[@${first.handle}](https://x.com/${first.handle})`;
      const bits = [who, fmtDate(first.date)];
      if (first.url) bits.push(`[View on X](${first.url})`);
      lines.push(bits.filter(Boolean).join(' · '), '');
    }
    for (const t of posts) {
      // reply chains can cross accounts; attribute those posts inline
      if (t.handle && first?.handle && t.handle !== first.handle) {
        lines.push(`*${t.author ? `${t.author} ` : ''}(@${t.handle})*`, '');
      }
      lines.push(t.text, '');
      // photos embed as standard Markdown images (permanent CDN links);
      // videos/GIFs become links, since .md files can't carry video
      for (const im of t.images ?? []) lines.push(`![media](${im.src})`, '');
      for (const m of t.media ?? []) {
        lines.push(m.postUrl ? `[${m.label} — watch on X](${m.postUrl})` : `[${m.label}]`, '');
      }
    }
    lines.push('---', '', '*Unrolled with [TwitterTools](https://twittertools.com) — free X thread reader.*', '');
    return lines.join('\n');
  }

  /** Formatted for pasting into an LLM (ChatGPT, Claude, Gemini): who wrote
   * it, when, and where it's from up top — the model can't know any of that
   * from the bare text — then posts delimited with plain "n/" markers and
   * media as bracketed notes. Respects the ticked selection; no promo. */
  function aiText(): string {
    const posts = selected();
    const first = posts[0];
    const by = first?.handle ? `${first.author ? `${first.author} ` : ''}(@${first.handle})` : '';
    const kind = posts.length > 1 ? 'Thread' : 'Post';
    const head = [
      by ? `${kind} by ${by}` : kind,
      fmtDate(first?.date),
      posts.length > 1 ? `${posts.length} posts` : '',
    ]
      .filter(Boolean)
      .join(' — ');
    const lines: string[] = [];
    if (head) lines.push(head);
    if (first?.url) lines.push(`Source: ${first.url}`);
    if (head || first?.url) lines.push('');
    posts.forEach((t, i) => {
      if (posts.length > 1) lines.push(`${i + 1}/`);
      // reply chains can cross accounts; attribute those posts inline
      if (t.handle && first?.handle && t.handle !== first.handle) {
        lines.push(`${t.author ? `${t.author} ` : ''}(@${t.handle}):`);
      }
      lines.push(t.text, '');
      const media = [
        ...(t.images ?? []).map((im) => `[photo: ${im.src}]`),
        ...(t.media ?? []).map((m) =>
          m.postUrl
            ? `[${m.label.toLowerCase()} — watch on X: ${m.postUrl}]`
            : `[${m.label.toLowerCase()}]`
        ),
      ];
      if (media.length) lines.push(...media, '');
    });
    return lines.join('\n').trimEnd() + '\n';
  }

  function htmlDoc(): string {
    const posts = selected();
    if (!posts.length) return '';
    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const first = posts[0];
    const title = deriveTitle();

    const items = posts
      .map((t) => {
        const other =
          t.handle && first.handle && t.handle !== first.handle
            ? `<p class="other">${esc(t.author ? `${t.author} (@${t.handle})` : `@${t.handle}`)}</p>`
            : '';
        const figs = t.images?.length
          ? `<figure class="imgs${t.images.length === 2 ? ' two' : ''}">` +
            t.images
              .map(
                (im) =>
                  `<img src="${esc(im.src)}" alt="" referrerpolicy="no-referrer" loading="lazy"${im.w && im.h ? ` width="${im.w}" height="${im.h}"` : ''}>`
              )
              .join('') +
            '</figure>'
          : '';
        const vids = (t.media ?? [])
          .map((m) => {
            const img = `<img src="${esc(m.poster)}" alt="${esc(m.label)}" referrerpolicy="no-referrer" loading="lazy">`;
            const tag = `<span class="tag">${esc(m.postUrl ? `${m.label} — watch on X ↗` : m.label)}</span>`;
            return m.postUrl
              ? `<a class="vid" href="${esc(m.postUrl)}" target="_blank" rel="noopener noreferrer">${img}${tag}</a>`
              : `<span class="vid">${img}${tag}</span>`;
          })
          .join('');
        return `<section>${other}<p>${esc(t.text).replace(/\n/g, '<br>')}</p>${figs}${vids}</section>`;
      })
      .join('\n');

    const avatar = first.avatar
      ? `<img class="avatar" src="${esc(first.avatar)}" alt="" referrerpolicy="no-referrer" onerror="this.remove()">`
      : '';
    const partial = posts.length !== thread.length;
    const countLabel =
      posts.length > 1
        ? partial
          ? `${posts.length} of ${thread.length} posts`
          : `${posts.length} posts`
        : '';
    const meta = [fmtDate(first.date), countLabel].filter(Boolean).join(' · ');
    const open = first.url
      ? ` · <a href="${esc(first.url)}" target="_blank" rel="noopener noreferrer">View on X ↗</a>`
      : '';
    const byline = first.handle
      ? `<header class="byline">${avatar}<div><span class="name">${esc(first.author ?? '')}</span> <span class="handle">@${esc(first.handle)}</span><span class="meta">${meta}${open}</span></div></header>`
      : '';

    return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc(title)}</title><style>
html{background:#fff;color-scheme:light}
body{font-family:Georgia,'Times New Roman',serif;font-size:17px;line-height:1.75;color:#1e293b;max-width:42rem;margin:2.5rem auto;padding:0 1.25rem}
h1{font-family:system-ui,-apple-system,sans-serif;font-size:1.45rem;line-height:1.3;color:#0f1419;margin:0 0 1.1rem}
.byline{display:flex;align-items:center;gap:.8rem;font-family:system-ui,-apple-system,sans-serif;padding-bottom:1.25rem;border-bottom:1px solid #e2e8f0;margin-bottom:1.6rem}
.avatar{width:44px;height:44px;border-radius:50%;object-fit:cover;background:#f1f5f9;flex-shrink:0}
.name{font-weight:600;font-size:.95rem;color:#0f1419}
.handle{font-size:.9rem;color:#64748b}
.meta{display:block;font-size:.8rem;color:#94a3b8;margin-top:2px}
.meta a{color:#64748b;text-decoration:none;border-bottom:1px dotted #cbd5e1}
section{margin-bottom:1.8rem}
.other{font-family:system-ui,-apple-system,sans-serif;font-size:.8rem;color:#64748b;margin:0 0 .3rem}
p{margin:0;white-space:pre-wrap}
figure.imgs{margin:1rem 0;display:grid;gap:8px}
figure.imgs.two{grid-template-columns:1fr 1fr}
figure.imgs img{display:block;width:100%;height:auto;border-radius:10px}
.vid{position:relative;display:block;margin-top:1rem;border-radius:10px;overflow:hidden}
.vid img{display:block;width:100%;height:auto}
.vid .tag{position:absolute;left:.75rem;top:.75rem;background:rgba(0,0,0,.65);color:#fff;font-size:.75rem;padding:.2rem .6rem;border-radius:9999px;font-family:system-ui,-apple-system,sans-serif}
footer{font-family:system-ui,-apple-system,sans-serif;font-size:.8rem;color:#94a3b8;margin-top:2.5rem;border-top:1px solid #f1f5f9;padding-top:1rem}
footer a{color:#64748b}
@media print{section,figure,.vid{break-inside:avoid}body{margin:0}}
</style></head><body><h1>${esc(title)}</h1>${byline}${items}<footer>Unrolled with <a href="https://twittertools.com">TwitterTools</a> — the independent toolkit for X.</footer></body></html>`;
  }

  function download(filename: string, content: string, type: string) {
    const blob = new Blob([content], { type });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 5000);
  }

  /** PDF export = the HTML export in a print-ready window; the browser's "Save as PDF" does the rest. */
  function pdfDoc(): string {
    const printCss = '<style>@page{margin:14mm}@media print{body{margin:1rem}}</style>';
    const autoprint = '<script>window.addEventListener("load",function(){setTimeout(function(){window.print()},400)})<\/script>';
    return htmlDoc().replace('</head>', printCss + autoprint + '</head>');
  }

  document.querySelectorAll<HTMLButtonElement>('.tr-exp').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!thread.length) return;
      if (!selected().length) {
        showError('Select at least one post to export.');
        return;
      }
      const stamp = new Date().toISOString().slice(0, 10);
      switch (btn.dataset.trExport) {
        case 'copy':
          await navigator.clipboard.writeText(plainText());
          break;
        case 'md':
          await navigator.clipboard.writeText(markdown());
          break;
        case 'ai':
          await navigator.clipboard.writeText(aiText());
          break;
        case 'txt':
          download(`thread-${stamp}.txt`, plainText(), 'text/plain');
          break;
        case 'mdfile':
          download(`thread-${stamp}.md`, markdown(), 'text/markdown');
          break;
        case 'html':
          download(`thread-${stamp}.html`, htmlDoc(), 'text/html');
          break;
        case 'pdf': {
          const w = window.open('', '_blank');
          if (!w) {
            showError('The PDF export opens a new window — please allow pop-ups for this site and try again.');
            return;
          }
          w.opener = null;
          w.document.write(pdfDoc());
          w.document.close();
          break;
        }
      }
      const old = btn.textContent;
      btn.textContent = '✓ Done';
      setTimeout(() => (btn.textContent = old), 1200);
    });
  });

  // Handoff from the Tweet Splitter ("Open in Thread Reader"): paste-format
  // text lands in the Paste mode and unrolls immediately
  try {
    const handoffText = sessionStorage.getItem('twittertools:tr-text');
    if (handoffText) {
      sessionStorage.removeItem('twittertools:tr-text');
      setMode('paste');
      textarea.value = handoffText;
      pasteBtn.click();
    }
  } catch {
    /* ignore */
  }

  // Deep link support (e.g. from the homepage router): /twitter-thread-reader?url=<post url>
  const deepLink = new URLSearchParams(window.location.search).get('url');
  if (deepLink && extractTweetId(deepLink)) {
    urlInput.value = deepLink;
    form.requestSubmit();
  }
</script>
