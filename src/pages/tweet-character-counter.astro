---
import Base from '../layouts/Base.astro';
import ToolHero from '../components/ToolHero.astro';
import Faq from '../components/Faq.astro';
import AdSlot from '../components/AdSlot.astro';
import { TOOLS } from '../lib/tools';

const faq = [
  {
    q: 'How does the X (Twitter) character counter work?',
    a: 'It uses the same weighted rules X applies when you post: most Latin characters count as 1, CJK characters and emoji count as 2, and every link counts as exactly 23 characters regardless of its length because X shortens all URLs with t.co.',
  },
  {
    q: 'Why does a link always count as 23 characters?',
    a: 'X wraps every URL in a t.co short link, which is fixed at 23 characters. A long URL takes no more space than a short one — but each separate link still costs the same 23.',
  },
  {
    q: 'How many characters can a post have?',
    a: 'A standard post allows 280 weighted characters. X Premium subscribers can publish much longer posts, but the 280 limit still applies to replies and quotes.',
  },
  {
    q: 'Do emoji really count as 2 characters?',
    a: 'Yes. Any character outside the Latin-1 range — including emoji, Chinese, Japanese and Korean characters — weighs 2 against the 280 limit.',
  },
];

  const seoDescription = "Count characters exactly like X (Twitter): 280 limit, CJK and emoji count double, every link counts as 23. Free, instant and private — nothing leaves your browser.";
const tool = TOOLS.find((t) => t.slug === '/tweet-character-counter/')!;
  const related = tool.related.map((s) => TOOLS.find((t) => t.slug === s)!);
  const toolLd = {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: tool.name,
    url: 'https://twittertools.com/tweet-character-counter/',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: seoDescription,
  };
---

<Base
  title="Free X (Twitter) Character Counter — 280 Limit, Links & Emoji"
  description={seoDescription}
  path="/tweet-character-counter/"
    jsonLd={[toolLd]}
>
  <ToolHero
    title="X (Twitter) Character Counter"
    subtitle="Type or paste your post — the counter applies X's real rules: 280 weighted characters, CJK and emoji count double, links count as 23."
  />

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <label for="tweet-text" class="mb-2 block text-sm font-medium text-slate-700">Your post</label>
    <textarea
      id="tweet-text"
      rows="6"
      class="w-full resize-y rounded-xl border border-slate-300 p-4 text-base leading-relaxed focus:border-brand focus:outline-none"
      placeholder="What's happening?&#10;&#10;Tip: paste a link to see how X counts it as 23 characters."
    ></textarea>

    <div class="mt-5">
      <div class="flex items-baseline justify-between">
        <p id="cc-big" class="text-4xl font-bold tabular-nums">0</p>
        <p id="cc-state" class="text-sm text-slate-500">of 280 characters</p>
      </div>
      <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-slate-100" role="presentation">
        <div id="cc-bar" class="h-full w-0 rounded-full bg-brand transition-all" style="width:0%"></div>
      </div>
      <div class="mt-4 flex flex-wrap gap-2 text-xs">
        <span class="rounded-full bg-slate-100 px-3 py-1 text-slate-600">Characters: <b id="cc-chars" class="tabular-nums">0</b></span>
        <span class="rounded-full bg-slate-100 px-3 py-1 text-slate-600">Links (23 each): <b id="cc-urls" class="tabular-nums">0</b></span>
        <span class="rounded-full bg-slate-100 px-3 py-1 text-slate-600">Double-weight (CJK/emoji): <b id="cc-heavy" class="tabular-nums">0</b></span>
        <span class="rounded-full bg-slate-100 px-3 py-1 text-slate-600">Remaining: <b id="cc-left" class="tabular-nums">280</b></span>
      </div>
      <button
        id="cc-split"
        class="mt-4 hidden rounded-full border border-brand px-4 py-2 text-xs font-semibold text-brand hover:bg-brand hover:text-white"
        >Over the limit? Split it into a thread →</button>
    </div>
  </section>

  <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-5">
    <p class="text-sm font-semibold">Writing toolkit</p>
    <p class="mt-1 text-sm text-slate-600">
      Count it here —
      <a class="font-medium text-brand hover:underline" href="/tweet-splitter/">split it into a thread</a> —
      style it with the
      <a class="font-medium text-brand hover:underline" href="/twitter-font-generator/">Font Generator</a>.
    </p>
  </section>

  <AdSlot />

  <section class="mt-12">
    <h2 class="text-xl font-bold">How X counts characters</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="font-semibold">280 weighted characters</p>
        <p class="mt-1 text-sm text-slate-600">
          The limit isn't a plain character count — it's a weighted score. Most characters cost 1,
          some cost 2.
        </p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="font-semibold">CJK & emoji cost 2</p>
        <p class="mt-1 text-sm text-slate-600">
          Chinese, Japanese, Korean characters and emoji weigh double — "你好" costs the same as
          4 Latin letters.
        </p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="font-semibold">Links cost 23</p>
        <p class="mt-1 text-sm text-slate-600">
          Every URL is wrapped in t.co and costs exactly 23 characters — no matter how long
          it is.
        </p>
      </div>
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-bold">How to check your post length</h2>
    <ol class="mt-4 grid gap-4 sm:grid-cols-3">
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-bold text-brand">Step 1</p>
        <p class="mt-1 font-medium">Type or paste</p>
        <p class="mt-1 text-sm text-slate-600">
          Write your post in the box above — or paste it in from anywhere. Nothing leaves your
          browser.
        </p>
      </li>
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-bold text-brand">Step 2</p>
        <p class="mt-1 font-medium">Watch the weighted count</p>
        <p class="mt-1 text-sm text-slate-600">
          The big number applies X's real rules: every link costs 23, CJK characters and emoji
          cost 2.
        </p>
      </li>
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-bold text-brand">Step 3</p>
        <p class="mt-1 font-medium">Trim to fit</p>
        <p class="mt-1 text-sm text-slate-600">
          The bar turns amber near the limit and red once you are over — edit until it fits.
        </p>
      </li>
    </ol>
  </section>

  <Faq items={faq} />

  <section class="mt-12">
    <h2 class="text-xl font-bold">Related tools</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-3">
      {
        related.map((t) => (
          <li>
            <a href={t.slug} class="block rounded-xl border border-slate-200 bg-white p-4 text-sm font-medium hover:border-brand">
              {t.name} <span class="text-slate-400">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  import { countTweet } from '../lib/tweet-count';

  const textarea = document.getElementById('tweet-text') as HTMLTextAreaElement;
  const big = document.getElementById('cc-big')!;
  const bar = document.getElementById('cc-bar')!;
  const chars = document.getElementById('cc-chars')!;
  const urls = document.getElementById('cc-urls')!;
  const heavy = document.getElementById('cc-heavy')!;
  const left = document.getElementById('cc-left')!;
  const state = document.getElementById('cc-state')!;

  function render() {
    const r = countTweet(textarea.value);
    big.textContent = String(r.weightedLength);
    chars.textContent = String(r.codePoints);
    urls.textContent = String(r.urlCount);
    heavy.textContent = String(r.heavyCodePoints);
    left.textContent = String(r.remaining);

    const pct = Math.min(100, (r.weightedLength / r.limit) * 100);
    bar.style.width = pct + '%';
    bar.className =
      'h-full rounded-full transition-all ' +
      (!r.valid ? 'bg-red-500' : pct > 90 ? 'bg-amber-500' : 'bg-brand');
    big.className =
      'text-4xl font-bold tabular-nums ' + (!r.valid ? 'text-red-500' : 'text-ink');

    state.textContent = r.valid
      ? `of ${r.limit} characters`
      : `${-r.remaining} characters over the limit`;
    state.className = 'text-sm ' + (!r.valid ? 'font-medium text-red-500' : 'text-slate-500');

    const splitBtn = document.getElementById('cc-split') as HTMLButtonElement | null;
    if (splitBtn) splitBtn.classList.toggle('hidden', r.valid || !textarea.value.trim());
  }

  const splitBtn = document.getElementById('cc-split') as HTMLButtonElement | null;
  splitBtn?.addEventListener('click', () => {
    sessionStorage.setItem('twittertools:split-text', textarea.value);
    window.location.href = '/tweet-splitter/';
  });

  textarea.addEventListener('input', render);
  render();
</script>
